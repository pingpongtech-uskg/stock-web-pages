---
// src/pages/index.astro — Screening results display
// Active: flat list sorted by most recent 上榜日 (newest first)
// Archive: date-grouped collapsible sections
import Layout from "../components/Layout.astro";
import ScreeningRow from "../components/ScreeningRow.astro";
import screenerData from "../data/screener_history.json";

interface ScreeningEntry {
  code: string;
  name_zh: string;
  name_en: string;
  net_amount_10d: number;
  net_amount_10d_k: number;
  net_shares_10d: number;
  net_shares_10d_zhang: number;
  first_date: string;
  last_date: string;
  consecutive_days: number;
  cur_price: number;
  g_score: number;
  l_score: number;
  regression_z: number;
  rank: number;
  screening_date: string;
}

const active = (screenerData.active || []) as ScreeningEntry[];
const archive = (screenerData.archive || {}) as Record<string, ScreeningEntry[]>;

// Sorted archive dates (descending)
const archiveDates = Object.keys(archive).sort((a, b) => b.localeCompare(a));
const totalArchiveEntries = archiveDates.reduce((sum, d) => sum + (archive[d]?.length || 0), 0);

const title = "Hermes Stock Radar";
const description = `${active.length} active screening results · ${totalArchiveEntries} archived`;
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description}>
  <header class="hero container">
    <nav class="topbar">
      <a href={base} class="brand" aria-label="Hermes Stock Radar">
        <img src={`${base}logo.svg`} alt="" width="36" height="36" />
        <span>Hermes Stock Radar</span>
      </a>
      <span class="data-note">TWSE screening results</span>
    </nav>

    <section class="hero-main">
      <div class="hero-copy">
        <p class="eyebrow">Liquid glass market console</p>
        <h1>Screening Results</h1>
        <p class="subtitle">Active: 近30日上榜，依最新上榜日排序。超過30日未上榜自動移至Archive。</p>
      </div>
      <div class="hero-metrics glass-surface" aria-label="Screening result summary">
        <div>
          <span class="metric-value">{active.length}</span>
          <span class="metric-label">Active</span>
        </div>
        <div>
          <span class="metric-value">{totalArchiveEntries}</span>
          <span class="metric-label">Archive</span>
        </div>
      </div>
    </section>
  </header>

  <main class="container">
    <section class="controls glass-surface" aria-label="Screening filters">
      <label class="search-wrap">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path d="M10.75 4.5a6.25 6.25 0 1 0 0 12.5 6.25 6.25 0 0 0 0-12.5Zm-7.75 6.25a7.75 7.75 0 1 1 13.78 4.88l3.3 3.29a.75.75 0 1 1-1.06 1.06l-3.29-3.3A7.75 7.75 0 0 1 3 10.75Z" fill="currentColor"/>
          </svg>
        </span>
        <input
          id="stock-search"
          type="search"
          placeholder="Search code or name"
          autocomplete="off"
          aria-label="Search stock code or name"
        />
      </label>

      <div class="status-tabs" role="tablist" aria-label="Screening status">
        <button class="status-tab active" type="button" data-status="active" role="tab" aria-selected="true">
          Active <span data-count="active">{active.length}</span>
        </button>
        <button class="status-tab" type="button" data-status="archive" role="tab" aria-selected="false">
          Archive <span data-count="archive">{totalArchiveEntries}</span>
        </button>
      </div>
    </section>

    <!-- Active Section -->
    <section id="section-active" class="results-section" data-section="active">
      <div class="results-head">
        <h2 id="results-title">Active</h2>
        <p><span id="visible-count-active">{active.length}</span> stocks — 依最新上榜日排序</p>
      </div>

      <div id="active-grid" class="results-list" aria-live="polite">
        {active.map((entry) => {
          const searchText = `${entry.code} ${entry.name_zh ?? ""} ${entry.name_en ?? ""}`.toLowerCase();
          return (
            <div
              class="screening-item"
              data-status="active"
              data-search={searchText}
            >
              <ScreeningRow entry={entry} variant="active" />
            </div>
          );
        })}
        <p id="empty-active" class="empty-state glass-surface" hidden>No matching active results.</p>
      </div>
    </section>

    <!-- Archive Section -->
    <section id="section-archive" class="results-section" data-section="archive" style="display:none">
      <div class="results-head">
        <h2>Archive</h2>
        <p><span id="visible-count-archive">{totalArchiveEntries}</span> entries across {archiveDates.length} dates</p>
      </div>

      <div id="archive-grid" class="archive-list" aria-live="polite">
        {archiveDates.map((dateStr) => {
          const entries = archive[dateStr] || [];
          return (
            <details class="archive-group glass-surface" open={archiveDates.indexOf(dateStr) < 3}>
              <summary class="archive-header">
                <span class="archive-date">{dateStr}</span>
                <span class="archive-count">{entries.length} stocks</span>
              </summary>
              <div class="archive-body" data-date={dateStr}>
                {entries.map((entry) => {
                  const searchText = `${entry.code} ${entry.name_zh ?? ""} ${entry.name_en ?? ""}`.toLowerCase();
                  return (
                    <div
                      class="screening-item"
                      data-status="archive"
                      data-search={searchText}
                      data-date={dateStr}
                    >
                      <ScreeningRow entry={entry} variant="archive" />
                    </div>
                  );
                })}
              </div>
            </details>
          );
        })}
        <p id="empty-archive" class="empty-state glass-surface" hidden>No matching archive results.</p>
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <p>資料來源: TWSE · 篩選條件: 投信10日買超TOP100 → Z≤0 → G≥80 & L≥80 · 技術指標僅供參考</p>
  </footer>
</Layout>

<script>
const search = document.getElementById("stock-search") as HTMLInputElement | null;
const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".status-tab"));
const sectionActive = document.getElementById("section-active");
const sectionArchive = document.getElementById("section-archive");
const emptyActive = document.getElementById("empty-active");
const emptyArchive = document.getElementById("empty-archive");
const countActive = document.getElementById("visible-count-active");
const countArchive = document.getElementById("visible-count-archive");
const titleEl = document.getElementById("results-title");
let selectedStatus = "active";

function applyFilters() {
  const query = (search?.value || "").trim().toLowerCase();

  // Show/hide sections
  if (sectionActive) sectionActive.style.display = selectedStatus === "active" ? "" : "none";
  if (sectionArchive) sectionArchive.style.display = selectedStatus === "archive" ? "" : "none";

  // Filter items in the active section
  let visibleActive = 0;
  const activeItems = document.querySelectorAll('#active-grid .screening-item');
  for (const item of activeItems) {
    const el = item as HTMLElement;
    const searchMatches = !query || (el.dataset.search || "").includes(query);
    el.hidden = !searchMatches;
    if (searchMatches) visibleActive++;
  }
  if (emptyActive) emptyActive.hidden = visibleActive !== 0;
  if (countActive) countActive.textContent = String(visibleActive);

  // Filter items in the archive section
  let visibleArchive = 0;
  const archiveItems = document.querySelectorAll('#archive-grid .screening-item');
  const archiveGroups = document.querySelectorAll('#archive-grid .archive-group');
  for (const group of archiveGroups) {
    const details = group as HTMLDetailsElement;
    let groupVisible = 0;
    const items = details.querySelectorAll('.screening-item');
    for (const item of items) {
      const el = item as HTMLElement;
      const searchMatches = !query || (el.dataset.search || "").includes(query);
      el.hidden = !searchMatches;
      if (searchMatches) groupVisible++;
    }
    details.hidden = groupVisible === 0;
    visibleArchive += groupVisible;
  }
  if (emptyArchive) emptyArchive.hidden = visibleArchive !== 0;
  if (countArchive) countArchive.textContent = String(visibleArchive);

  if (titleEl) titleEl.textContent = selectedStatus === "archive" ? "Archive" : "Active";
}

for (const tab of tabs) {
  tab.addEventListener("click", () => {
    selectedStatus = tab.dataset.status || "active";
    for (const current of tabs) {
      const isActive = current === tab;
      current.classList.toggle("active", isActive);
      current.setAttribute("aria-selected", String(isActive));
    }
    applyFilters();
  });
}

search?.addEventListener("input", applyFilters);
applyFilters();
</script>

<style>
/* ═══ Hero (unchanged from original) ═══ */
.hero {
  padding: 26px 0 22px;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 38px;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--color-text);
  font-size: 0.98rem;
  font-weight: 820;
  text-decoration: none;
}
.brand img {
  display: block;
  filter: drop-shadow(0 10px 18px rgba(23, 107, 135, 0.22));
}
.data-note {
  color: var(--color-muted);
  font-size: 0.82rem;
}
.hero-main {
  min-height: 248px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
  align-items: end;
  gap: 26px;
}
.hero-copy {
  max-width: 760px;
}
.eyebrow {
  margin: 0 0 10px;
  color: var(--color-primary);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}
h1 {
  margin: 0;
  max-width: 780px;
  font-size: clamp(3rem, 8vw, 6.6rem);
  line-height: 0.92;
  letter-spacing: 0;
}
.subtitle {
  max-width: 640px;
  margin: 18px 0 0;
  color: var(--color-ink-soft);
  font-size: 1rem;
  line-height: 1.7;
}
.hero-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  border-radius: 8px;
  overflow: hidden;
}
.hero-metrics div {
  min-height: 112px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 18px;
  background: rgba(255,255,255,0.18);
}
.metric-value {
  font-size: 2rem;
  font-weight: 860;
}
.metric-label {
  margin-top: 4px;
  color: var(--color-muted);
  font-size: 0.8rem;
  font-weight: 740;
}

/* ═══ Controls (unchanged) ═══ */
.controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 14px;
  align-items: center;
  margin: 8px 0 24px;
  padding: 10px;
  border-radius: 8px;
  position: sticky;
  top: 10px;
  z-index: 4;
}
.search-wrap {
  min-width: 0;
  height: 46px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 14px;
  border: 1px solid var(--color-line);
  border-radius: 8px;
  background: rgba(255,255,255,0.42);
}
.search-icon {
  width: 18px;
  height: 18px;
  color: var(--color-muted);
}
.search-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}
.search-wrap input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-text);
  font-size: 0.95rem;
}
.search-wrap input::placeholder {
  color: var(--color-muted);
}
.status-tabs {
  display: inline-grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--color-line);
  border-radius: 8px;
  background: rgba(255,255,255,0.34);
}
.status-tab {
  min-width: 116px;
  height: 38px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--color-muted);
  cursor: pointer;
  font-size: 0.86rem;
  font-weight: 780;
  transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}
.status-tab span {
  color: inherit;
  opacity: 0.72;
}
.status-tab.active {
  background: var(--color-card-strong);
  color: var(--color-text);
  box-shadow: 0 8px 18px rgba(36,55,72,0.12);
}

/* ═══ Results ═══ */
.results-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}
.results-head h2 {
  margin: 0;
  font-size: 1rem;
}
.results-head p {
  margin: 0;
  color: var(--color-muted);
  font-size: 0.84rem;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-bottom: 48px;
}

.screening-item[hidden] {
  display: none;
}

/* ═══ Archive groups ═══ */
.archive-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 48px;
}
.archive-group {
  border-radius: var(--radius-card, 8px);
  overflow: hidden;
}
.archive-group[hidden] {
  display: none;
}
.archive-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  cursor: pointer;
  list-style: none;
  user-select: none;
  position: relative;
  z-index: 1;
}
.archive-header::-webkit-details-marker {
  display: none;
}
.archive-date {
  font-size: 1rem;
  font-weight: 800;
  color: var(--color-text);
}
.archive-count {
  font-size: 0.78rem;
  color: var(--color-muted);
  font-weight: 750;
}
.archive-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 0 10px 12px 10px;
}

.empty-state {
  margin: 0 0 48px;
  padding: 28px;
  border-radius: 8px;
  color: var(--color-muted);
  text-align: center;
}

/* ═══ Footer ═══ */
.page-footer {
  color: var(--color-muted, #667085);
  font-size: 0.8rem;
  padding: 26px 16px 34px;
  text-align: center;
}

/* ═══ Responsive ═══ */
@media (max-width: 1024px) {
  .hero-main {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .hero-metrics {
    max-width: 440px;
  }
}
@media (max-width: 700px) {
  .hero {
    padding-top: 18px;
  }
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 30px;
  }
  h1 {
    font-size: 3.25rem;
  }
  .controls {
    position: static;
    grid-template-columns: 1fr;
  }
  .status-tabs {
    width: 100%;
  }
  .status-tab {
    min-width: 0;
  }
}
@media (max-width: 420px) {
  .container {
    width: min(100% - 20px, 1200px);
  }
  h1 {
    font-size: 2.8rem;
  }
}
</style>
