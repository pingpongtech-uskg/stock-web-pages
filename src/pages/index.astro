---
// src/pages/index.astro — public institutional screener results
import Layout from "../components/Layout.astro";
import ScreeningRow from "../components/ScreeningRow.astro";
import screenerData from "../data/public_screener.json";

interface CategoryScore {
  passed: number;
  failed: number;
  unknown: number;
  not_applicable?: number;
  total: number;
  score: string;
  status: string;
}

interface ScreeningEntry {
  code: string;
  market: string;
  name_zh: string;
  name_en?: string;
  net_amount_10d: number;
  net_amount_10d_k: number;
  net_shares_10d: number;
  net_shares_10d_zhang: number;
  last_date: string;
  window_dates?: string[];
  window_net_shares?: number[];
  cur_price: number;
  regression_z: number | null;
  z_status?: string;
  rank: number;
  screening_date: string;
  categories: Record<string, CategoryScore>;
  criteria: unknown[];
  data_quality?: { unknown_criteria?: number; coverage?: number };
}

const records = ((screenerData.records || []) as ScreeningEntry[]).filter((entry) => entry && entry.code);
const active = ((screenerData.active || records) as ScreeningEntry[]).filter((entry) => entry && entry.code);
const archive = (screenerData.archive || {}) as Record<string, ScreeningEntry[]>;
const archiveDates = Object.keys(archive).sort((a, b) => b.localeCompare(a));
const totalArchiveEntries = archiveDates.reduce((sum, d) => sum + (archive[d]?.length || 0), 0);
const categoryOptions = (screenerData.category_filter_options || []) as { id: string; label: string }[];
const zOptions = (screenerData.z_options || [0, 1, 2]) as number[];
const defaultZ = Number(screenerData.z_default ?? 0);

const title = "Hermes Stock Radar";
const description = `${active.length} active screening results · ${records.length} candidates`;
const base = import.meta.env.BASE_URL;
const generatedAt = (screenerData as { generated_at?: string | null }).generated_at ?? "";
function formatTaipei(isoUtc: string): string {
  if (!isoUtc) return "";
  const d = new Date(isoUtc.endsWith("Z") ? isoUtc : isoUtc + "Z");
  if (Number.isNaN(d.getTime())) return isoUtc;
  const t = new Date(d.getTime() + 8 * 3600 * 1000);
  const p = (n: number) => String(n).padStart(2, "0");
  return `${t.getUTCFullYear()}-${p(t.getUTCMonth() + 1)}-${p(t.getUTCDate())} ${p(t.getUTCHours())}:${p(t.getUTCMinutes())}`;
}
const lastUpdated = formatTaipei(generatedAt);
function categoryPasses(entry: ScreeningEntry, id: string): boolean {
  const score = entry.categories?.[id];
  return Boolean(score && score.total > 0 && score.passed / score.total > 0.5);
}
---

<Layout title={title} description={description}>
  <header class="hero container">
    <nav class="topbar">
      <a href={base} class="brand" aria-label="Hermes Stock Radar">
        <img src={`${base}logo.svg`} alt="" width="36" height="36" />
        <span>Hermes Stock Radar</span>
      </a>
      <div class="topbar-right">
        <a href={`${base}chat`} class="chat-link" aria-label="AI 策略問答">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>問 AI</span>
        </a>
        <span class="data-note">Official institutional flow · public data</span>
      </div>
    </nav>

    <section class="hero-main">
      <div class="hero-copy">
        <p class="eyebrow">Daily institutional screener</p>
        <h1>投信買超雷達</h1>
        <p class="subtitle">先依投信 10 日累積買超股數取候選，再以每日收盤價排序買超金額。G/L 已移除；每檔保留七類分數與每一項 criteria 明細。</p>
        <p class="updated-note">最後更新: {lastUpdated || "—"}（台北時間）</p>
      </div>
      <div class="hero-metrics" aria-label="Screening summary">
        <div><span class="metric-value" data-count="active">{active.length}</span><span class="metric-label">Z 預設通過</span></div>
        <div><span class="metric-value">{records.length}</span><span class="metric-label">金額候選</span></div>
      </div>
    </section>
  </header>

  <main class="container">
    <section class="controls surface" aria-label="Screening filters">
      <label class="search-wrap">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img"><path d="M10.75 4.5a6.25 6.25 0 1 0 0 12.5 6.25 6.25 0 0 0 0-12.5Zm-7.75 6.25a7.75 7.75 0 1 1 13.78 4.88l3.3 3.29a.75.75 0 1 1-1.06 1.06l-3.29-3.3A7.75 7.75 0 0 1 3 10.75Z" fill="currentColor"/></svg>
        </span>
        <input id="stock-search" type="search" placeholder="搜尋代號或名稱" autocomplete="off" aria-label="Search stock code or name" />
      </label>

      <fieldset class="z-filters">
        <legend>Z 篩選</legend>
        {zOptions.map((value) => (
          <label class:list={["z-option", { selected: value === defaultZ }]}>
            <input type="radio" name="z-max" value={value} checked={value === defaultZ} />
            <span>Z≤{value}</span>
          </label>
        ))}
      </fieldset>

      <fieldset class="category-filters">
        <legend>類別（可複選，AND）</legend>
        {categoryOptions.map((option) => (
          <label class:list={["category-option", { selected: option.id === "all" }]}>
            <input type="checkbox" value={option.id} data-category-filter={option.id} checked={option.id === "all"} />
            <span>{option.label}</span>
          </label>
        ))}
      </fieldset>

      <div class="status-tabs" role="tablist" aria-label="Screening status">
        <button class="status-tab active" type="button" data-status="active" role="tab" aria-selected="true">目前候選 <span data-count="active">{active.length}</span></button>
        <button class="status-tab" type="button" data-status="archive" role="tab" aria-selected="false">歷史 <span>{totalArchiveEntries}</span></button>
      </div>
    </section>

    <section id="section-active" class="results-section" data-section="active">
      <div class="results-head">
        <h2 id="results-title">目前候選</h2>
        <p><span id="visible-count-active">{active.length}</span> stocks — 預設 Z≤{defaultZ}</p>
      </div>
      <div id="active-grid" class="results-list" aria-live="polite">
        {records.map((entry) => {
          const searchText = `${entry.code} ${entry.name_zh ?? ""} ${entry.name_en ?? ""}`.toLowerCase();
          const categoryState = Object.fromEntries(categoryOptions.filter((option) => option.id !== "all").map((option) => [option.id, categoryPasses(entry, option.id)]));
          return (
            <div class="screening-item" data-status="active" data-search={searchText} data-z={entry.regression_z ?? ""} data-categories={JSON.stringify(categoryState)}>
              <ScreeningRow entry={entry} variant="active" />
            </div>
          );
        })}
        <p id="empty-active" class="empty-state surface" hidden>目前篩選沒有符合標的。</p>
      </div>
    </section>

    <section id="section-archive" class="results-section" data-section="archive" style="display:none">
      <div class="results-head">
        <h2>歷史</h2>
        <p><span id="visible-count-archive">{totalArchiveEntries}</span> entries across {archiveDates.length} dates</p>
      </div>
      <div id="archive-grid" class="archive-list" aria-live="polite">
        {archiveDates.map((dateStr) => {
          const entries = archive[dateStr] || [];
          return (
            <details class="archive-group surface" open={archiveDates.indexOf(dateStr) < 3}>
              <summary class="archive-header"><span class="archive-date">{dateStr}</span><span class="archive-count">{entries.length} stocks</span></summary>
              <div class="archive-body" data-date={dateStr}>
                {entries.map((entry) => {
                  const searchText = `${entry.code} ${entry.name_zh ?? ""} ${entry.name_en ?? ""}`.toLowerCase();
                  const categoryState = Object.fromEntries(categoryOptions.filter((option) => option.id !== "all").map((option) => [option.id, categoryPasses(entry, option.id)]));
                  return <div class="screening-item" data-status="archive" data-search={searchText} data-z={entry.regression_z ?? ""} data-categories={JSON.stringify(categoryState)}><ScreeningRow entry={entry} variant="archive" /></div>;
                })}
              </div>
            </details>
          );
        })}
        <p id="empty-archive" class="empty-state surface" hidden>目前篩選沒有歷史標的。</p>
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <p>資料來源: TWSE T86 · TPEx 三大法人 API · 投信 10 日累積買超股數 × 官方收盤價 · Z 預設 ≤{defaultZ} · G/L filter removed · 點擊股票查看 criteria 明細</p>
  </footer>
</Layout>

<script>
const search = document.getElementById("stock-search") as HTMLInputElement | null;
const statusTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".status-tab"));
const zInputs = Array.from(document.querySelectorAll<HTMLInputElement>("input[name='z-max']"));
const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>("[data-category-filter]"));
const sectionActive = document.getElementById("section-active");
const sectionArchive = document.getElementById("section-archive");
const emptyActive = document.getElementById("empty-active");
const emptyArchive = document.getElementById("empty-archive");
const countActive = document.getElementById("visible-count-active");
const countArchive = document.getElementById("visible-count-archive");
const titleEl = document.getElementById("results-title");
let selectedStatus = "active";

function selectedZ(): number {
  const selected = zInputs.find((input) => input.checked)?.value;
  const value = Number(selected ?? "0");
  return Number.isFinite(value) ? value : 0;
}

function selectedCategories(): string[] {
  return categoryInputs.filter((input) => input.checked && input.value !== "all").map((input) => input.value);
}

function itemMatches(item: Element, query: string): boolean {
  const el = item as HTMLElement;
  if (query && !(el.dataset.search || "").includes(query)) return false;
  const z = Number(el.dataset.z);
  if (!Number.isFinite(z) || z > selectedZ()) return false;
  const categories = JSON.parse(el.dataset.categories || "{}");
  return selectedCategories().every((category) => categories[category] === true);
}

function refreshSelectedStyles(): void {
  for (const input of [...zInputs, ...categoryInputs]) {
    input.closest("label")?.classList.toggle("selected", input.checked);
  }
}

function applyFilters(): void {
  const query = (search?.value || "").trim().toLowerCase();
  refreshSelectedStyles();
  if (sectionActive) sectionActive.style.display = selectedStatus === "active" ? "" : "none";
  if (sectionArchive) sectionArchive.style.display = selectedStatus === "archive" ? "" : "none";

  let visibleActive = 0;
  for (const item of document.querySelectorAll("#active-grid .screening-item")) {
    const matches = itemMatches(item, query);
    (item as HTMLElement).hidden = !matches;
    if (matches) visibleActive++;
  }
  if (emptyActive) emptyActive.hidden = visibleActive !== 0;
  if (countActive) countActive.textContent = String(visibleActive);

  let visibleArchive = 0;
  for (const group of document.querySelectorAll<HTMLDetailsElement>("#archive-grid .archive-group")) {
    let groupVisible = 0;
    for (const item of group.querySelectorAll(".screening-item")) {
      const matches = itemMatches(item, query);
      (item as HTMLElement).hidden = !matches;
      if (matches) groupVisible++;
    }
    group.hidden = groupVisible === 0;
    visibleArchive += groupVisible;
  }
  if (emptyArchive) emptyArchive.hidden = visibleArchive !== 0;
  if (countArchive) countArchive.textContent = String(visibleArchive);
  if (titleEl) titleEl.textContent = selectedStatus === "archive" ? "歷史" : "目前候選";
}

for (const input of zInputs) input.addEventListener("change", applyFilters);
for (const input of categoryInputs) {
  input.addEventListener("change", () => {
    if (input.value === "all" && input.checked) {
      for (const other of categoryInputs) if (other.value !== "all") other.checked = false;
    } else if (input.value !== "all" && input.checked) {
      const all = categoryInputs.find((candidate) => candidate.value === "all");
      if (all) all.checked = false;
    }
    if (!categoryInputs.some((candidate) => candidate.checked)) {
      const all = categoryInputs.find((candidate) => candidate.value === "all");
      if (all) all.checked = true;
    }
    applyFilters();
  });
}
for (const tab of statusTabs) {
  tab.addEventListener("click", () => {
    selectedStatus = tab.dataset.status || "active";
    for (const current of statusTabs) {
      const activeTab = current === tab;
      current.classList.toggle("active", activeTab);
      current.setAttribute("aria-selected", String(activeTab));
    }
    applyFilters();
  });
}
search?.addEventListener("input", applyFilters);
applyFilters();
</script>

<style>
/* ═══ Hero ═══ */
.hero {
  padding: 40px 0 28px;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 38px;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--color-text);
  font-size: 0.95rem;
  font-weight: 700;
}
.brand img {
  display: block;
}
.data-note {
  color: var(--color-text-muted);
  font-size: 0.82rem;
}
.topbar-right {
  display: flex;
  align-items: center;
  gap: 14px;
}
.chat-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 6px;
  background: var(--color-accent);
  color: #fff;
  font-size: 0.82rem;
  font-weight: 600;
  transition: background 0.15s;
}
.chat-link:hover {
  background: var(--color-accent-hover);
}
.hero-main {
  min-height: 200px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
  align-items: end;
  gap: 26px;
}
.hero-copy {
  max-width: 760px;
}
.eyebrow {
  margin: 0 0 10px;
  color: var(--color-accent);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}
h1 {
  margin: 0;
  max-width: 780px;
  font-size: clamp(2.5rem, 7vw, 5.5rem);
  line-height: 0.94;
  letter-spacing: -0.02em;
  font-weight: 800;
}
.subtitle {
  max-width: 640px;
  margin: 16px 0 0;
  color: var(--color-text-soft);
  font-size: 0.95rem;
  line-height: 1.7;
}
.hero-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.hero-metrics div {
  min-height: 100px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 18px;
  background: var(--color-bg-subtle);
}
.hero-metrics div:first-child {
  border-right: 1px solid var(--color-border);
}
.metric-value {
  font-size: 2rem;
  font-weight: 800;
}
.metric-label {
  margin-top: 4px;
  color: var(--color-text-muted);
  font-size: 0.8rem;
  font-weight: 600;
}

.updated-note {
  margin: 10px 0 0;
  color: var(--color-text-muted);
  font-size: 0.8rem;
  font-weight: 600;
}
.updated-note::before {
  content: "●";
  color: var(--color-accent);
  margin-right: 6px;
  font-size: 0.62rem;
  vertical-align: middle;
}

/* ═══ Controls ═══ */
.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin: 8px 0 24px;
  padding: 10px;
  border-radius: var(--radius-md);
  position: sticky;
  top: 10px;
  z-index: 4;
}
.search-wrap {
  flex: 1 1 220px;
  min-width: 0;
  height: 44px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.search-wrap:focus-within {
  border-color: var(--color-accent);
}
.search-icon {
  width: 18px;
  height: 18px;
  color: var(--color-text-muted);
}
.search-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}
.search-wrap input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-text);
  font-size: 0.95rem;
}
.search-wrap input::placeholder {
  color: var(--color-text-muted);
}
.z-filters,
.category-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
  margin: 0;
  padding: 4px;
  border: 0;
}
.z-filters legend,
.category-filters legend {
  flex: 0 0 auto;
  margin-right: 3px;
  color: var(--color-text-muted);
  font-size: 0.68rem;
  font-weight: 750;
}
.z-option,
.category-option {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 32px;
  padding: 5px 9px;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: var(--color-bg-subtle);
  color: var(--color-text-muted);
  cursor: pointer;
  font-size: 0.72rem;
  font-weight: 650;
  white-space: nowrap;
  transition: background 0.12s, color 0.12s, border-color 0.12s;
}
.z-option input,
.category-option input { accent-color: var(--color-accent); }
.z-option.selected,
.category-option.selected {
  border-color: var(--color-accent);
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.status-tabs {
  display: inline-grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-subtle);
}
.status-tab {
  min-width: 116px;
  height: 36px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: var(--color-text-muted);
  cursor: pointer;
  font-size: 0.84rem;
  font-weight: 600;
  transition: background 0.12s, color 0.12s;
}
.status-tab span {
  color: inherit;
  opacity: 0.72;
}
.status-tab.active {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

/* ═══ Results ═══ */
.results-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}
.results-head h2 {
  margin: 0;
  font-size: 1rem;
}
.results-head p {
  margin: 0;
  color: var(--color-text-muted);
  font-size: 0.84rem;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-bottom: 48px;
}

.screening-item[hidden] {
  display: none;
}

/* ═══ Archive groups ═══ */
.archive-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 48px;
}
.archive-group {
  border-radius: var(--radius-md);
  overflow: hidden;
}
.archive-group[hidden] {
  display: none;
}
.archive-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  cursor: pointer;
  list-style: none;
  user-select: none;
  position: relative;
  z-index: 1;
}
.archive-header::-webkit-details-marker {
  display: none;
}
.archive-date {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-text);
}
.archive-count {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  font-weight: 600;
}
.archive-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 0 10px 12px 10px;
}

.empty-state {
  margin: 0 0 48px;
  padding: 28px;
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  text-align: center;
}

/* ═══ Footer ═══ */
.page-footer {
  color: var(--color-text-muted);
  font-size: 0.8rem;
  padding: 26px 16px 34px;
  text-align: center;
  border-top: 1px solid var(--color-border);
}

/* ═══ Responsive ═══ */
@media (max-width: 1024px) {
  .hero-main {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .hero-metrics {
    max-width: 440px;
  }
}
@media (max-width: 700px) {
  .hero {
    padding-top: 20px;
  }
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 30px;
  }
  h1 {
    font-size: 2.8rem;
  }
  .controls {
    position: static;
    grid-template-columns: 1fr;
  }
  .status-tabs {
    width: 100%;
  }
  .status-tab {
    min-width: 0;
  }
}
@media (max-width: 420px) {
  .container {
    width: min(100% - 20px, 1200px);
  }
  h1 {
    font-size: 2.2rem;
  }
}
</style>
