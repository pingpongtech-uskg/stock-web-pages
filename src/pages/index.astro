---
// src/pages/index.astro — Stock screening results
import Layout from "../components/Layout.astro";
import StockCard from "../components/StockCard.astro";
import stocks from "../data/stocks_summary.json";

interface StockSummary {
  code: string;
  name: string;
  latest: { price: number; change_pct: number; volume: number };
  ma_status: string;
  sparkline: number[];
  screening_status?: "active" | "archive";
  last_screened_at?: string;
  days_since_screened?: number;
}

const stockList = stocks as StockSummary[];
const activeStocks = stockList.filter((stock) => (stock.screening_status ?? "active") !== "archive");
const archiveStocks = stockList.filter((stock) => stock.screening_status === "archive");

const title = "Hermes Stock Radar";
const description = `${activeStocks.length} active screening results · ${archiveStocks.length} archived`;
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description}>
  <header class="hero container">
    <nav class="topbar">
      <a href={base} class="brand" aria-label="Hermes Stock Radar">
        <img src={`${base}logo.svg`} alt="" width="36" height="36" />
        <span>Hermes Stock Radar</span>
      </a>
      <span class="data-note">TWSE screening results</span>
    </nav>

    <section class="hero-main">
      <div class="hero-copy">
        <p class="eyebrow">Liquid glass market console</p>
        <h1>Screening Results</h1>
        <p class="subtitle">Active names stay live. Archive names keep the last screened price snapshot after 30 idle days.</p>
      </div>
      <div class="hero-metrics glass-surface" aria-label="Screening result summary">
        <div>
          <span class="metric-value">{activeStocks.length}</span>
          <span class="metric-label">Active</span>
        </div>
        <div>
          <span class="metric-value">{archiveStocks.length}</span>
          <span class="metric-label">Archive</span>
        </div>
      </div>
    </section>
  </header>

  <main class="container">
    <section class="controls glass-surface" aria-label="Screening filters">
      <label class="search-wrap">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path d="M10.75 4.5a6.25 6.25 0 1 0 0 12.5 6.25 6.25 0 0 0 0-12.5Zm-7.75 6.25a7.75 7.75 0 1 1 13.78 4.88l3.3 3.29a.75.75 0 1 1-1.06 1.06l-3.29-3.3A7.75 7.75 0 0 1 3 10.75Z" fill="currentColor"/>
          </svg>
        </span>
        <input
          id="stock-search"
          type="search"
          placeholder="Search code or name"
          autocomplete="off"
          aria-label="Search stock code or name"
        />
      </label>

      <div class="status-tabs" role="tablist" aria-label="Screening status">
        <button class="status-tab active" type="button" data-status="active" role="tab" aria-selected="true">
          Active <span data-count="active">{activeStocks.length}</span>
        </button>
        <button class="status-tab" type="button" data-status="archive" role="tab" aria-selected="false">
          Archive <span data-count="archive">{archiveStocks.length}</span>
        </button>
      </div>
    </section>

    <section class="results-head">
      <h2 id="results-title">Active</h2>
      <p><span id="visible-count">{activeStocks.length}</span> results</p>
    </section>

    <section id="stock-grid" class="stock-grid" aria-live="polite">
      {stockList.map((stock) => {
        const status = stock.screening_status ?? "active";
        const searchText = `${stock.code} ${stock.name ?? ""}`.toLowerCase();

        return (
          <article
            class="stock-item"
            data-status={status}
            data-search={searchText}
          >
            <StockCard
              code={stock.code}
              name={stock.name}
              price={stock.latest.price}
              changePct={stock.latest.change_pct}
              volume={stock.latest.volume}
              maStatus={stock.ma_status}
              closes={stock.sparkline}
              status={status}
              lastScreenedAt={stock.last_screened_at}
              daysSinceScreened={stock.days_since_screened}
            />
          </article>
        );
      })}
    </section>

    <p id="empty-state" class="empty-state glass-surface" hidden>No matching screening results.</p>
  </main>

  <footer class="page-footer">
    <p>資料來源: TWSE · 技術指標僅供參考</p>
  </footer>
</Layout>

<script>
const search = document.getElementById("stock-search") as HTMLInputElement | null;
const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".status-tab"));
const items = Array.from(document.querySelectorAll<HTMLElement>(".stock-item"));
const title = document.getElementById("results-title");
const count = document.getElementById("visible-count");
const empty = document.getElementById("empty-state");
let selectedStatus = "active";

function applyFilters() {
  const query = (search?.value || "").trim().toLowerCase();
  let visible = 0;

  for (const item of items) {
    const statusMatches = item.dataset.status === selectedStatus;
    const searchMatches = !query || (item.dataset.search || "").includes(query);
    const shouldShow = statusMatches && searchMatches;
    item.hidden = !shouldShow;
    if (shouldShow) visible += 1;
  }

  if (title) title.textContent = selectedStatus === "archive" ? "Archive" : "Active";
  if (count) count.textContent = String(visible);
  if (empty) empty.hidden = visible !== 0;
}

for (const tab of tabs) {
  tab.addEventListener("click", () => {
    selectedStatus = tab.dataset.status || "active";
    for (const current of tabs) {
      const isActive = current === tab;
      current.classList.toggle("active", isActive);
      current.setAttribute("aria-selected", String(isActive));
    }
    applyFilters();
  });
}

search?.addEventListener("input", applyFilters);
applyFilters();
</script>

<style>
.hero {
  padding: 26px 0 22px;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 38px;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--color-text);
  font-size: 0.98rem;
  font-weight: 820;
  text-decoration: none;
}
.brand img {
  display: block;
  filter: drop-shadow(0 10px 18px rgba(23, 107, 135, 0.22));
}
.data-note {
  color: var(--color-muted);
  font-size: 0.82rem;
}
.hero-main {
  min-height: 248px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
  align-items: end;
  gap: 26px;
}
.hero-copy {
  max-width: 760px;
}
.eyebrow {
  margin: 0 0 10px;
  color: var(--color-primary);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}
h1 {
  margin: 0;
  max-width: 780px;
  font-size: clamp(3rem, 8vw, 6.6rem);
  line-height: 0.92;
  letter-spacing: 0;
}
.subtitle {
  max-width: 640px;
  margin: 18px 0 0;
  color: var(--color-ink-soft);
  font-size: 1rem;
  line-height: 1.7;
}
.hero-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  border-radius: 8px;
  overflow: hidden;
}
.hero-metrics div {
  min-height: 112px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 18px;
  background: rgba(255,255,255,0.18);
}
.metric-value {
  font-size: 2rem;
  font-weight: 860;
}
.metric-label {
  margin-top: 4px;
  color: var(--color-muted);
  font-size: 0.8rem;
  font-weight: 740;
}
.controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 14px;
  align-items: center;
  margin: 8px 0 24px;
  padding: 10px;
  border-radius: 8px;
  position: sticky;
  top: 10px;
  z-index: 4;
}
.search-wrap {
  min-width: 0;
  height: 46px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 14px;
  border: 1px solid var(--color-line);
  border-radius: 8px;
  background: rgba(255,255,255,0.42);
}
.search-icon {
  width: 18px;
  height: 18px;
  color: var(--color-muted);
}
.search-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}
.search-wrap input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-text);
  font-size: 0.95rem;
}
.search-wrap input::placeholder {
  color: var(--color-muted);
}
.status-tabs {
  display: inline-grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--color-line);
  border-radius: 8px;
  background: rgba(255,255,255,0.34);
}
.status-tab {
  min-width: 116px;
  height: 38px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--color-muted);
  cursor: pointer;
  font-size: 0.86rem;
  font-weight: 780;
  transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}
.status-tab span {
  color: inherit;
  opacity: 0.72;
}
.status-tab.active {
  background: var(--color-card-strong);
  color: var(--color-text);
  box-shadow: 0 8px 18px rgba(36,55,72,0.12);
}
.results-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}
.results-head h2 {
  margin: 0;
  font-size: 1rem;
}
.results-head p {
  margin: 0;
  color: var(--color-muted);
  font-size: 0.84rem;
}
.stock-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  padding-bottom: 48px;
}
.stock-item[hidden] {
  display: none;
}
.empty-state {
  margin: 0 0 48px;
  padding: 28px;
  border-radius: 8px;
  color: var(--color-muted);
  text-align: center;
}
.page-footer {
  color: var(--color-muted, #667085);
  font-size: 0.8rem;
  padding: 26px 16px 34px;
  text-align: center;
}
@media (max-width: 1024px) {
  .hero-main {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .hero-metrics {
    max-width: 440px;
  }
  .stock-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 700px) {
  .hero {
    padding-top: 18px;
  }
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 30px;
  }
  h1 {
    font-size: 3.25rem;
  }
  .controls {
    position: static;
    grid-template-columns: 1fr;
  }
  .status-tabs {
    width: 100%;
  }
  .status-tab {
    min-width: 0;
  }
  .stock-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 420px) {
  .container {
    width: min(100% - 20px, 1200px);
  }
  h1 {
    font-size: 2.8rem;
  }
}
</style>
