---
// src/pages/index.astro — Screener history console
import Layout from "../components/Layout.astro";
import history from "../data/screening_history.json";

interface ScreeningRecord {
  id: string;
  code: string;
  name: string;
  rank?: number;
  price?: number;
  net_amount_10d_k?: number;
  net_shares_10d_zhang?: number;
  g_score?: number;
  l_score?: number;
  regression_z?: number;
  last_buy_date?: string;
  screened_at: string;
  screening_status: "active" | "archive";
  days_since_screened?: number;
  archived_at?: string | null;
}

interface ScreeningDay {
  date: string;
  count: number;
  records: ScreeningRecord[];
}

interface ScreeningHistory {
  reference_date: string;
  criteria: string[];
  summary: {
    active_stocks: number;
    archive_stocks: number;
    trading_days: number;
    total_records: number;
  };
  active_days: ScreeningDay[];
  archive_days: ScreeningDay[];
}

const data = history as ScreeningHistory;
const activeDays = data.active_days ?? [];
const archiveDays = data.archive_days ?? [];
const base = import.meta.env.BASE_URL;
const title = "投信初建倉 · 歷史篩選總表";
const description = `Active ${data.summary.active_stocks} · Archive ${data.summary.archive_stocks}`;

function formatNumber(value?: number): string {
  if (value === undefined || value === null) return "—";
  return Number(value).toLocaleString("zh-TW");
}

function formatPrice(value?: number): string {
  if (value === undefined || value === null) return "—";
  return Number(value).toFixed(2);
}

function scoreClass(value?: number): string {
  if (value === undefined || value === null) return "";
  if (value >= 100) return "score-good";
  if (value >= 80) return "score-watch";
  return "score-muted";
}

function zClass(value?: number): string {
  if (value === undefined || value === null) return "";
  return value <= -1 ? "z-low" : "z-mid";
}

function daySearchText(day: ScreeningDay): string {
  return day.records.map((record) => `${record.code} ${record.name}`).join(" ").toLowerCase();
}
---

<Layout title={title} description={description}>
  <main class="console-page container">
    <header class="console-header">
      <a href={base} class="brand-mark" aria-label="投信初建倉歷史篩選總表">
        <img src={`${base}logo.svg`} alt="" width="38" height="38" />
      </a>
      <div class="title-block">
        <h1>{title}</h1>
        <p>
          篩選條件：投信十日買超排行前 100 → Z ≤ 0 → G ≥ 80 & L ≥ 80
          <span>共 {data.summary.trading_days} 個交易日 · {data.summary.total_records} 筆篩選紀錄</span>
        </p>
      </div>
    </header>

    <section class="toolbar glass-surface" aria-label="篩選結果工具列">
      <label class="search-wrap">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M10.75 4.5a6.25 6.25 0 1 0 0 12.5 6.25 6.25 0 0 0 0-12.5Zm-7.75 6.25a7.75 7.75 0 1 1 13.78 4.88l3.3 3.29a.75.75 0 1 1-1.06 1.06l-3.29-3.3A7.75 7.75 0 0 1 3 10.75Z" fill="currentColor"/>
          </svg>
        </span>
        <input id="screening-search" type="search" placeholder="搜尋代號或名稱" autocomplete="off" aria-label="搜尋股票代號或名稱" />
      </label>

      <div class="status-tabs" role="tablist" aria-label="Active Archive">
        <button class="status-tab active" type="button" data-status="active" role="tab" aria-selected="true">
          Active <span>{data.summary.active_stocks}</span>
        </button>
        <button class="status-tab" type="button" data-status="archive" role="tab" aria-selected="false">
          Archive <span>{data.summary.archive_stocks}</span>
        </button>
      </div>

      <div class="view-actions" aria-label="日期區塊控制">
        <button type="button" data-action="expand">全部展開</button>
        <button type="button" data-action="collapse">全部收合</button>
      </div>
    </section>

    <section class="summary-strip" aria-label="篩選統計">
      <div class="metric glass-surface">
        <span>{data.summary.active_stocks}</span>
        <p>Active 股票</p>
      </div>
      <div class="metric glass-surface">
        <span>{data.summary.archive_stocks}</span>
        <p>Archive 股票</p>
      </div>
      <div class="metric glass-surface">
        <span>{data.summary.trading_days}</span>
        <p>交易日</p>
      </div>
      <div class="metric glass-surface">
        <span>{data.reference_date}</span>
        <p>判定日期</p>
      </div>
    </section>

    <section class="criteria-line" aria-label="完整篩選條件">
      {data.criteria.map((criterion) => <span>{criterion}</span>)}
    </section>

    <section class="results-panel" data-panel-status="active">
      <div class="panel-heading">
        <h2>Active Screening Results</h2>
        <p><span data-visible-count>{data.summary.active_stocks}</span> stocks matching current view</p>
      </div>
      <div class="day-list">
        {activeDays.map((day, index) => (
          <details
            class="day-group glass-surface"
            open={index === 0}
            data-day
            data-search={daySearchText(day)}
          >
            <summary>
              <span class="chevron" aria-hidden="true"></span>
              <strong>{day.date}</strong>
              <span class="count-badge" data-day-count>{day.count}</span>
              <span class="rule-tag">TOP100 金額 → Z&lt;=0 → G&gt;=80 & L&gt;=80</span>
            </summary>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>代號</th>
                    <th>名稱</th>
                    <th>現價</th>
                    <th>投信10日買超金額</th>
                    <th>投信10日買超張數</th>
                    <th>成長</th>
                    <th>地雷</th>
                    <th>Z-SCORE</th>
                    <th>上榜日</th>
                    <th>閒置天數</th>
                  </tr>
                </thead>
                <tbody>
                  {day.records.map((record) => (
                    <tr data-record data-search={`${record.code} ${record.name}`.toLowerCase()}>
                      <td><a class="stock-code" href={`${base}${record.code}/`}>{record.code}</a></td>
                      <td>{record.name}</td>
                      <td class="num strong">{formatPrice(record.price)}</td>
                      <td class="num">{formatNumber(record.net_amount_10d_k)} 千</td>
                      <td class="num">{formatNumber(record.net_shares_10d_zhang)}</td>
                      <td class={scoreClass(record.g_score)}>{formatNumber(record.g_score)}</td>
                      <td class={scoreClass(record.l_score)}>{formatNumber(record.l_score)}</td>
                      <td class={zClass(record.regression_z)}>{record.regression_z ?? "—"}</td>
                      <td>{record.screened_at}</td>
                      <td>{record.days_since_screened ?? 0}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="results-panel" data-panel-status="archive" hidden>
      <div class="panel-heading">
        <h2>Archived Screening Results</h2>
        <p><span data-visible-count>{data.summary.archive_stocks}</span> stocks matching current view</p>
      </div>
      <div class="day-list">
        {archiveDays.map((day, index) => (
          <details
            class="day-group glass-surface archive-group"
            open={index === 0}
            data-day
            data-search={daySearchText(day)}
          >
            <summary>
              <span class="chevron" aria-hidden="true"></span>
              <strong>{day.date}</strong>
              <span class="count-badge" data-day-count>{day.count}</span>
              <span class="rule-tag">最後一次命中後 30 天未再出現</span>
            </summary>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>代號</th>
                    <th>名稱</th>
                    <th>封存價</th>
                    <th>投信10日買超金額</th>
                    <th>投信10日買超張數</th>
                    <th>成長</th>
                    <th>地雷</th>
                    <th>Z-SCORE</th>
                    <th>最後上榜</th>
                    <th>封存日</th>
                  </tr>
                </thead>
                <tbody>
                  {day.records.map((record) => (
                    <tr data-record data-search={`${record.code} ${record.name}`.toLowerCase()}>
                      <td><a class="stock-code" href={`${base}${record.code}/`}>{record.code}</a></td>
                      <td>{record.name}</td>
                      <td class="num strong">{formatPrice(record.price)}</td>
                      <td class="num">{formatNumber(record.net_amount_10d_k)} 千</td>
                      <td class="num">{formatNumber(record.net_shares_10d_zhang)}</td>
                      <td class={scoreClass(record.g_score)}>{formatNumber(record.g_score)}</td>
                      <td class={scoreClass(record.l_score)}>{formatNumber(record.l_score)}</td>
                      <td class={zClass(record.regression_z)}>{record.regression_z ?? "—"}</td>
                      <td>{record.screened_at}</td>
                      <td>{record.archived_at ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))}
      </div>
    </section>

    <p id="empty-state" class="empty-state glass-surface" hidden>沒有符合目前條件的篩選紀錄。</p>
  </main>
</Layout>

<script>
const search = document.getElementById("screening-search") as HTMLInputElement | null;
const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".status-tab"));
const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel-status]"));
const actionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-action]"));
const empty = document.getElementById("empty-state");
let selectedStatus = "active";

function activePanel() {
  return panels.find((panel) => panel.dataset.panelStatus === selectedStatus) || null;
}

function applyFilters() {
  const query = (search?.value || "").trim().toLowerCase();
  let visibleRows = 0;
  let visibleDays = 0;

  for (const panel of panels) {
    const isSelected = panel.dataset.panelStatus === selectedStatus;
    panel.hidden = !isSelected;
    if (!isSelected) continue;

    const days = Array.from(panel.querySelectorAll<HTMLElement>("[data-day]"));
    for (const day of days) {
      let dayRows = 0;
      const rows = Array.from(day.querySelectorAll<HTMLTableRowElement>("[data-record]"));
      for (const row of rows) {
        const isMatch = !query || (row.dataset.search || "").includes(query);
        row.hidden = !isMatch;
        if (isMatch) {
          dayRows += 1;
          visibleRows += 1;
        }
      }
      day.hidden = dayRows === 0;
      const badge = day.querySelector<HTMLElement>("[data-day-count]");
      if (badge) badge.textContent = String(dayRows);
      if (dayRows > 0) visibleDays += 1;
    }

    const count = panel.querySelector<HTMLElement>("[data-visible-count]");
    if (count) count.textContent = String(visibleRows);
  }

  if (empty) empty.hidden = visibleRows !== 0 || visibleDays !== 0;
}

for (const tab of tabs) {
  tab.addEventListener("click", () => {
    selectedStatus = tab.dataset.status || "active";
    for (const current of tabs) {
      const isActive = current === tab;
      current.classList.toggle("active", isActive);
      current.setAttribute("aria-selected", String(isActive));
    }
    applyFilters();
  });
}

for (const button of actionButtons) {
  button.addEventListener("click", () => {
    const panel = activePanel();
    if (!panel) return;
    const shouldOpen = button.dataset.action === "expand";
    for (const day of panel.querySelectorAll<HTMLDetailsElement>("details[data-day]")) {
      if (!day.hidden) day.open = shouldOpen;
    }
  });
}

search?.addEventListener("input", applyFilters);
applyFilters();
</script>

<style>
.console-page {
  padding: 34px 0 58px;
}
.console-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin: 20px 0 26px;
  text-align: center;
}
.brand-mark {
  display: inline-flex;
  flex: 0 0 auto;
  filter: drop-shadow(0 12px 18px rgba(23, 107, 135, 0.24));
}
.brand-mark img {
  display: block;
}
.title-block h1 {
  margin: 0;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  line-height: 1.1;
  letter-spacing: 0;
}
.title-block p {
  margin: 9px 0 0;
  color: var(--color-muted);
  font-size: 0.95rem;
  line-height: 1.6;
}
.title-block p span {
  display: inline-block;
  margin-left: 10px;
}
.toolbar {
  position: sticky;
  top: 10px;
  z-index: 8;
  display: grid;
  grid-template-columns: minmax(260px, 1fr) auto auto;
  gap: 12px;
  align-items: center;
  padding: 10px;
  border-radius: 8px;
}
.search-wrap {
  min-width: 0;
  height: 44px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 13px;
  border: 1px solid var(--color-line);
  border-radius: 8px;
  background: rgba(255,255,255,0.42);
}
.search-icon {
  width: 18px;
  height: 18px;
  color: var(--color-muted);
}
.search-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}
.search-wrap input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-text);
  font-size: 0.93rem;
}
.search-wrap input::placeholder {
  color: var(--color-muted);
}
.status-tabs {
  display: inline-grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--color-line);
  border-radius: 8px;
  background: rgba(255,255,255,0.34);
}
.status-tab,
.view-actions button {
  height: 36px;
  border: 0;
  border-radius: 6px;
  color: var(--color-muted);
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 760;
}
.status-tab {
  min-width: 112px;
  padding: 0 14px;
  background: transparent;
}
.status-tab span {
  margin-left: 6px;
  opacity: 0.72;
}
.status-tab.active {
  background: var(--color-card-strong);
  color: var(--color-text);
  box-shadow: 0 8px 18px rgba(36,55,72,0.12);
}
.view-actions {
  display: flex;
  gap: 8px;
}
.view-actions button {
  padding: 0 14px;
  border: 1px solid var(--color-line);
  background: rgba(255,255,255,0.32);
}
.summary-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 18px 0 16px;
}
.metric {
  min-height: 78px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 14px 16px;
  border-radius: 8px;
}
.metric span {
  color: var(--color-text);
  font-size: 1.45rem;
  font-weight: 860;
}
.metric p {
  margin: 4px 0 0;
  color: var(--color-muted);
  font-size: 0.8rem;
  font-weight: 720;
}
.criteria-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 18px;
}
.criteria-line span {
  padding: 7px 10px;
  border: 1px solid var(--color-line);
  border-radius: 999px;
  background: rgba(255,255,255,0.32);
  color: var(--color-muted);
  font-size: 0.78rem;
  font-weight: 720;
}
.panel-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14px;
  margin: 8px 0 10px;
}
.panel-heading h2 {
  margin: 0;
  font-size: 1rem;
}
.panel-heading p {
  margin: 0;
  color: var(--color-muted);
  font-size: 0.82rem;
}
.results-panel {
  min-width: 0;
}
.day-list {
  display: grid;
  gap: 9px;
  min-width: 0;
}
.day-group {
  overflow: clip;
  border-radius: 8px;
  min-width: 0;
}
.day-group[hidden] {
  display: none;
}
.day-group summary {
  min-height: 54px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  cursor: pointer;
  list-style: none;
}
.day-group summary::-webkit-details-marker {
  display: none;
}
.chevron {
  width: 0;
  height: 0;
  border-top: 5px solid transparent;
  border-bottom: 5px solid transparent;
  border-left: 7px solid var(--color-muted);
  transition: transform 0.16s ease;
}
.day-group[open] .chevron {
  transform: rotate(90deg);
}
.day-group summary strong {
  font-size: 1.05rem;
  font-weight: 820;
}
.count-badge {
  min-width: 30px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 9px;
  border-radius: 999px;
  background: #5aa7ff;
  color: #06111f;
  font-size: 0.85rem;
  font-weight: 850;
}
.rule-tag {
  color: var(--color-muted);
  font-size: 0.86rem;
}
.table-scroll {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  border-top: 1px solid var(--color-line);
}
table {
  width: 100%;
  min-width: 1060px;
  border-collapse: collapse;
  font-size: 0.9rem;
}
th,
td {
  height: 42px;
  padding: 0 14px;
  border-bottom: 1px solid var(--color-line);
  text-align: left;
  white-space: nowrap;
}
th {
  background: rgba(73, 88, 114, 0.1);
  color: var(--color-muted);
  font-size: 0.78rem;
  font-weight: 820;
}
tbody tr {
  background: rgba(255,255,255,0.12);
}
tbody tr:hover {
  background: rgba(90, 167, 255, 0.12);
}
tr[hidden] {
  display: none;
}
.stock-code {
  color: #2f86e9;
  font-weight: 850;
  text-decoration: none;
}
.stock-code:hover {
  text-decoration: underline;
}
.num {
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.strong {
  color: var(--color-text);
  font-weight: 790;
}
.score-good {
  color: #24b653;
  font-weight: 840;
}
.score-watch {
  color: #d59b0b;
  font-weight: 840;
}
.score-muted {
  color: var(--color-muted);
}
.z-low {
  color: #24b653;
  font-weight: 800;
}
.z-mid {
  color: #d59b0b;
  font-weight: 800;
}
.archive-group {
  opacity: 0.92;
}
.empty-state {
  margin: 18px 0 0;
  padding: 28px;
  border-radius: 8px;
  color: var(--color-muted);
  text-align: center;
}
.empty-state[hidden] {
  display: none;
}
@media (max-width: 960px) {
  .toolbar {
    position: static;
    grid-template-columns: 1fr;
  }
  .status-tabs,
  .view-actions {
    width: 100%;
  }
  .status-tab,
  .view-actions button {
    flex: 1;
    min-width: 0;
  }
  .summary-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 620px) {
  .console-page {
    padding-top: 18px;
  }
  .console-header {
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
  }
  .title-block p span {
    display: block;
    margin-left: 0;
    margin-top: 3px;
  }
  .summary-strip {
    grid-template-columns: 1fr 1fr;
  }
  .metric {
    min-height: 70px;
  }
  .metric span {
    font-size: 1.05rem;
  }
  .panel-heading {
    align-items: flex-start;
    flex-direction: column;
  }
  .day-group summary {
    flex-wrap: wrap;
  }
  .rule-tag {
    width: 100%;
    padding-left: 17px;
  }
}
</style>
