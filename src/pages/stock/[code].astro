---
import Layout from "../../components/Layout.astro";
import screenerData from "../../data/public_screener.json";

interface Criterion {
  criterion_id: string;
  label?: string;
  status: string;
  value?: unknown;
  threshold?: unknown;
  period?: string | null;
  reason?: string | null;
  proxy?: boolean;
  source_snapshot?: string[];
  details?: Record<string, unknown>;
}
interface Category {
  passed: number;
  failed: number;
  unknown: number;
  not_applicable?: number;
  total: number;
  score: string;
  status: string;
  criteria?: Criterion[];
}
interface Entry {
  code: string;
  market?: string;
  name_zh: string;
  name_en?: string;
  net_amount_10d: number;
  net_shares_10d: number;
  net_shares_10d_zhang?: number;
  cur_price: number;
  regression_z: number | null;
  rank?: number;
  screening_date?: string;
  last_date: string;
  window_dates?: string[];
  window_net_shares?: number[];
  categories: Record<string, Category>;
  criteria: Criterion[];
  data_quality?: { unknown_criteria?: number; proxy_criteria?: number; coverage?: number };
  formula_version?: string;
  model_version?: string;
}

export function getStaticPaths() {
  const data = screenerData as unknown as { records?: Entry[]; archive?: Record<string, Entry[]> };
  const byCode = new Map<string, Entry>();
  for (const entry of data.records || []) byCode.set(entry.code, entry);
  for (const entries of Object.values(data.archive || {})) for (const entry of entries || []) byCode.set(entry.code, entry);
  return Array.from(byCode.values()).map((entry) => ({ params: { code: entry.code }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const categories = [
  ["turnaround", "轉機股"],
  ["value", "便宜股"],
  ["growth", "成長股"],
  ["chip", "籌碼"],
  ["dividend", "定存股"],
  ["continuity", "績優股"],
  ["safety", "排除地雷股"],
] as const;

function statusLabel(status: string): string {
  return { pass: "過關", fail: "不過關", unknown: "資料不足", not_applicable: "不適用" }[status] || status;
}
function statusClass(status: string): string {
  return status === "pass" ? "pass" : status === "fail" ? "fail" : status === "not_applicable" ? "na" : "unknown";
}
function displayValue(value: unknown): string {
  if (value === null || value === undefined || value === "") return "—";
  if (typeof value === "object") return JSON.stringify(value, null, 0);
  if (typeof value === "boolean") return value ? "是" : "否";
  if (typeof value === "number") return Number.isInteger(value) ? value.toLocaleString() : value.toFixed(4);
  return String(value);
}
function categoryCriteria(entry: Entry, key: string, category?: Category): Criterion[] {
  const fromEntry = (entry.criteria || []).filter((item) => item.criterion_id?.startsWith(`${key}.`));
  return fromEntry.length ? fromEntry : category?.criteria || [];
}

const title = `${entry.code} ${entry.name_zh} · 投信買超雷達`;
---

<Layout title={title} description={`${entry.name_zh} 七大類 criteria 詳情`}>
  <main class="detail-page container">
    <a href={import.meta.env.BASE_URL} class="back-link">← 回到投信買超列表</a>

    <header class="detail-header surface">
      <div>
        <div class="identity-line">
          <span class="stock-code">{entry.code}</span>
          <span class="market">{entry.market || "—"}</span>
          <span class="stock-name">{entry.name_zh}</span>
        </div>
        <p class="meta">掃描日 {entry.screening_date || entry.last_date} · 金額排行 #{entry.rank ?? "—"} · 模型 {entry.model_version || "public-data-health-v1"}</p>
      </div>
      <div class="headline-metrics">
        <div><span>投信 10 日買超</span><strong>{entry.net_shares_10d.toLocaleString()} 股</strong></div>
        <div><span>買超金額</span><strong>{entry.net_amount_10d.toLocaleString()} 元</strong></div>
        <div><span>收盤價</span><strong>{Number(entry.cur_price || 0).toFixed(2)}</strong></div>
        <div><span>Z</span><strong class:list={[{ "z-pass": entry.regression_z != null && entry.regression_z <= 0, "z-unknown": entry.regression_z == null }]}>{entry.regression_z == null ? "—" : entry.regression_z.toFixed(2)}</strong></div>
      </div>
    </header>

    <section class="summary-section">
      <div class="section-heading"><h1>七大類總覽</h1><span>每類門檻：passed / total &gt; 50%</span></div>
      <div class="category-grid">
        {categories.map(([key, label]) => {
          const category = entry.categories?.[key];
          return (
            <article class:list={["category-card", statusClass(category?.status || "unknown")]}>
              <div class="category-card-head"><h2>{label}</h2><span>{statusLabel(category?.status || "unknown")}</span></div>
              <strong class="category-score">{category?.score || "—"}</strong>
              <div class="category-counts"><span>過關 {category?.passed ?? 0}</span><span>不過 {category?.failed ?? 0}</span><span>未知 {category?.unknown ?? 0}</span></div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="criteria-section">
      <div class="section-heading"><h1>Criteria 詳情</h1><span>{entry.criteria?.length || 0} 項 · formula {entry.formula_version || "public-data-health-v1"}</span></div>
      {categories.map(([key, label]) => {
        const category = entry.categories?.[key];
        const criteria = categoryCriteria(entry, key, category);
        return (
          <details class="criteria-group surface" open>
            <summary><span>{label}</span><strong>{category?.score || "—"}</strong><em>{statusLabel(category?.status || "unknown")}</em></summary>
            <div class="criteria-list">
              {criteria.length === 0 && <p class="no-data">此類別目前沒有可顯示的 criterion。</p>}
              {criteria.map((criterion) => (
                <article class:list={["criterion", statusClass(criterion.status)]}>
                  <div class="criterion-title"><span class="status-dot" aria-hidden="true"></span><div><strong>{criterion.label || criterion.criterion_id}</strong><small>{criterion.criterion_id}{criterion.proxy ? " · public proxy" : ""}</small></div><b>{statusLabel(criterion.status)}</b></div>
                  <dl class="criterion-facts">
                    <div><dt>實際值</dt><dd>{displayValue(criterion.value)}</dd></div>
                    <div><dt>門檻</dt><dd>{displayValue(criterion.threshold)}</dd></div>
                    <div><dt>期間</dt><dd>{criterion.period || "—"}</dd></div>
                    <div><dt>原因</dt><dd>{criterion.reason || "—"}</dd></div>
                  </dl>
                  {criterion.details && Object.keys(criterion.details).length > 0 && <pre>{JSON.stringify(criterion.details, null, 2)}</pre>}
                  {(criterion.source_snapshot || []).length > 0 && <p class="source-line">snapshot：{criterion.source_snapshot?.join(" · ")}</p>}
                </article>
              ))}
            </div>
          </details>
        );
      })}
    </section>

    <section class="quality-note surface">
      <h2>資料品質</h2>
      <p>UNKNOWN 不算過關，也沒有被移除分母。未知 {entry.data_quality?.unknown_criteria ?? 0} 項 · proxy {entry.data_quality?.proxy_criteria ?? 0} 項 · coverage {entry.data_quality?.coverage == null ? "—" : `${(entry.data_quality.coverage * 100).toFixed(1)}%`}。</p>
      <p>本頁是公開資料自有模型，不宣稱 StatementDog exact compatibility。</p>
    </section>
  </main>
</Layout>

<style>
.detail-page { padding: 28px 16px 60px; }
.back-link { display: inline-block; color: var(--color-accent); font-size: .86rem; margin-bottom: 18px; text-decoration: none; }
.back-link:hover { text-decoration: underline; }
.detail-header { display: flex; justify-content: space-between; gap: 24px; padding: 22px; border-radius: var(--radius-md); margin-bottom: 30px; }
.identity-line { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
.stock-code { font-size: 1.7rem; font-weight: 850; }
.market { color: var(--color-accent); font-size: .7rem; font-weight: 800; }
.stock-name { font-size: 1.15rem; font-weight: 700; }
.meta { margin: 10px 0 0; color: var(--color-text-muted); font-size: .78rem; }
.headline-metrics { display: grid; grid-template-columns: repeat(4, minmax(80px, 1fr)); gap: 8px; min-width: min(100%, 500px); }
.headline-metrics div { display: flex; flex-direction: column; gap: 4px; padding: 9px 11px; border-radius: 7px; background: var(--color-bg-subtle); }
.headline-metrics span { color: var(--color-text-muted); font-size: .66rem; }
.headline-metrics strong { font-size: .9rem; }
.z-pass { color: var(--color-accent); }
.z-unknown { color: var(--color-text-muted); }
.summary-section, .criteria-section { margin-bottom: 30px; }
.section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 12px; }
.section-heading h1 { margin: 0; font-size: 1.15rem; letter-spacing: 0; line-height: 1.2; }
.section-heading span { color: var(--color-text-muted); font-size: .75rem; }
.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px; }
.category-card { padding: 13px; border-radius: var(--radius-md); background: var(--color-bg-subtle); border: 1px solid var(--color-border); }
.category-card.pass { border-color: color-mix(in srgb, var(--color-accent) 60%, var(--color-border)); }
.category-card.fail { border-color: color-mix(in srgb, var(--color-down, #f23645) 50%, var(--color-border)); }
.category-card-head { display: flex; justify-content: space-between; gap: 5px; align-items: center; }
.category-card h2 { margin: 0; font-size: .78rem; }
.category-card-head span, .category-counts { color: var(--color-text-muted); font-size: .64rem; }
.category-score { display: block; margin: 8px 0 5px; font-size: 1.45rem; }
.category-counts { display: flex; gap: 7px; flex-wrap: wrap; }
.category-card.pass .category-score, .category-card.pass .category-card-head span { color: var(--color-accent); }
.category-card.fail .category-card-head span { color: var(--color-down, #f23645); }
.criteria-group { margin-bottom: 9px; border-radius: var(--radius-md); overflow: hidden; }
.criteria-group > summary { display: flex; align-items: center; gap: 13px; padding: 13px 16px; cursor: pointer; list-style: none; font-weight: 750; }
.criteria-group > summary::-webkit-details-marker { display: none; }
.criteria-group > summary strong { margin-left: auto; font-size: .84rem; }
.criteria-group > summary em { color: var(--color-text-muted); font-size: .7rem; font-style: normal; }
.criteria-list { display: flex; flex-direction: column; gap: 6px; padding: 0 9px 9px; }
.criterion { padding: 13px; border-radius: 8px; background: var(--color-bg-subtle); border-left: 3px solid var(--color-border); }
.criterion.pass { border-left-color: var(--color-accent); }
.criterion.fail { border-left-color: var(--color-down, #f23645); }
.criterion.unknown { border-left-color: var(--color-muted, #667085); }
.criterion-title { display: flex; align-items: center; gap: 8px; }
.criterion-title > div { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.criterion-title strong { font-size: .8rem; }
.criterion-title small { color: var(--color-text-muted); font-size: .62rem; overflow-wrap: anywhere; }
.criterion-title b { margin-left: auto; flex: 0 0 auto; font-size: .7rem; }
.criterion.pass .criterion-title b { color: var(--color-accent); }
.criterion.fail .criterion-title b { color: var(--color-down, #f23645); }
.criterion.unknown .criterion-title b, .criterion.na .criterion-title b { color: var(--color-text-muted); }
.status-dot { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: var(--color-muted, #667085); }
.criterion.pass .status-dot { background: var(--color-accent); }
.criterion.fail .status-dot { background: var(--color-down, #f23645); }
.criterion-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; margin: 12px 0 0 16px; }
.criterion-facts div { min-width: 0; }
.criterion-facts dt { color: var(--color-text-muted); font-size: .62rem; }
.criterion-facts dd { margin: 3px 0 0; font-size: .72rem; overflow-wrap: anywhere; }
.criterion pre { margin: 10px 0 0 16px; padding: 8px; max-height: 180px; overflow: auto; border-radius: 5px; background: rgba(0,0,0,.04); color: var(--color-text-muted); font-size: .62rem; white-space: pre-wrap; }
.source-line { margin: 9px 0 0 16px; color: var(--color-text-muted); font-size: .61rem; overflow-wrap: anywhere; }
.no-data { padding: 10px; color: var(--color-text-muted); font-size: .75rem; }
.quality-note { padding: 15px 17px; border-radius: var(--radius-md); color: var(--color-text-muted); font-size: .75rem; line-height: 1.65; }
.quality-note h2 { margin: 0 0 6px; color: var(--color-text); font-size: .88rem; }
.quality-note p { margin: 3px 0; }
@media (max-width: 900px) { .detail-header { flex-direction: column; } .headline-metrics { min-width: 0; } .category-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 620px) { .headline-metrics { grid-template-columns: repeat(2, 1fr); } .category-grid { grid-template-columns: repeat(2, 1fr); } .criterion-facts { grid-template-columns: repeat(2, 1fr); } }
</style>
