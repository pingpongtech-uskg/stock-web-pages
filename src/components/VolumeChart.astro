---
// src/components/VolumeChart.astro — ECharts volume bar chart
---

<div id="volume-chart" style="width:100%;height:160px"></div>

<script>
import * as echarts from "echarts";

function initVolumeChart() {
  const el = document.getElementById("volume-chart");
  if (!el) return;
  
  const raw = document.getElementById("stock-data");
  if (!raw) return;
  
  const stock = JSON.parse(raw.textContent || "{}");
  const { dates, close, volume } = stock.price || {};
  if (!dates || !volume) return;

  // Color bars: red if close > previous close, green otherwise
  const volColors = close.map((v: number | null, i: number) => {
    if (i === 0) return "#1db954";
    const prev = close[i - 1];
    const curr = close[i];
    if (prev === null || curr === null) return "#6b7280";
    return curr >= prev ? "#ea4335" : "#1db954";
  });

  const chart = echarts.init(el);
  chart.setOption({
    tooltip: { trigger: "axis" },
    grid: { left: "3%", right: "3%", top: 8, bottom: 8 },
    xAxis: {
      type: "category",
      data: dates,
      axisLabel: { show: false },
      axisTick: { show: false },
    },
    yAxis: {
      type: "value",
      axisLabel: {
        formatter: (v: number) => v >= 1e8 ? (v / 1e8).toFixed(0) + "億" : (v / 1e4).toFixed(0) + "萬",
        fontSize: 10,
      },
      splitLine: { lineStyle: { color: "#e5e7eb" } },
    },
    series: [{
      name: "成交量",
      type: "bar",
      data: volume.map((v: number | null, i: number) => ({
        value: v,
        itemStyle: { color: volColors[i] },
      })),
    }],
  });

  window.addEventListener("resize", () => chart.resize());
}

initVolumeChart();
</script>
