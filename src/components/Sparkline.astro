---
// Sparkline.astro — Inline SVG mini price chart for stock cards
export interface Props {
  closes: number[];
  width?: number;
  height?: number;
  color?: string;
}

const { closes, width = 120, height = 32, color = "#1a73e8" } = Astro.props;

// Filter out nulls for the valid close points
const valid = closes.filter((v): v is number => v !== null && v !== undefined);
if (valid.length < 2) {
  // Not enough data
  // Return empty
}

const min = Math.min(...valid);
const max = Math.max(...valid);
const range = max - min || 1;

const points = valid.map((v, i) => {
  const x = (i / (valid.length - 1)) * width;
  const y = height - ((v - min) / range) * (height - 4) - 2;
  return `${x},${y}`;
}).join(" ");

const isUp = valid[valid.length - 1] >= valid[0];
const strokeColor = color;
---

<svg 
  width={width} 
  height={height} 
  viewBox={`0 0 ${width} ${height}`}
  style="display:block;overflow:visible"
  aria-label="Price sparkline"
>
  <polyline
    points={points}
    fill="none"
    stroke={strokeColor}
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
