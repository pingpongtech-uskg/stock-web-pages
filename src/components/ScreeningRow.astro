---
// ScreeningRow.astro — public screener candidate row
export interface CategoryScore {
  passed: number;
  failed: number;
  unknown: number;
  not_applicable?: number;
  total: number;
  score: string;
  status: string;
}

export interface ScreeningEntry {
  code: string;
  market?: string;
  name_zh: string;
  name_en?: string;
  net_amount_10d: number;
  net_amount_10d_k?: number;
  net_shares_10d: number;
  net_shares_10d_zhang?: number;
  last_date: string;
  window_dates?: string[];
  cur_price: number;
  regression_z: number | null;
  z_status?: string;
  rank?: number;
  screening_date?: string;
  categories?: Record<string, CategoryScore>;
  data_quality?: { unknown_criteria?: number; coverage?: number };
}

interface Props {
  entry: ScreeningEntry;
  variant?: "active" | "archive";
}

const { entry, variant = "active" } = Astro.props;
const isArchive = variant === "archive";
const detailUrl = `${import.meta.env.BASE_URL}stock/${entry.code}`;
const categoryMeta = [
  ["turnaround", "轉機"],
  ["value", "便宜"],
  ["growth", "成長"],
  ["chip", "籌碼"],
  ["dividend", "定存"],
  ["continuity", "績優"],
  ["safety", "地雷"],
] as const;
const categories = entry.categories || {};

function fmtAmount(value: number): string {
  if (value >= 1e8) return `${(value / 1e8).toFixed(2)} 億`;
  if (value >= 1e4) return `${(value / 1e4).toFixed(1)} 萬`;
  return value.toLocaleString();
}

function fmtShares(value: number): string {
  if (value >= 10000) return `${(value / 10000).toFixed(1)} 萬張`;
  if (value >= 1000) return `${(value / 1000).toFixed(1)} 千張`;
  return `${value.toLocaleString()} 張`;
}

function categoryPercent(category: CategoryScore | undefined): string {
  if (!category || !category.total) return "—";
  return `${(category.passed / category.total * 100).toFixed(0)}%`;
}

function statusClass(category: CategoryScore | undefined): string {
  if (!category) return "unknown";
  if (category.status === "pass") return "pass";
  if (category.status === "fail") return "fail";
  if (category.status === "not_applicable") return "na";
  return "unknown";
}

function fmtZ(value: number | null): string {
  return value == null || !Number.isFinite(value) ? "—" : value.toFixed(2);
}
---

<a href={detailUrl} class:list={["screening-row", "surface", { "is-archive": isArchive }]} aria-label={`${entry.code} ${entry.name_zh} criteria 詳情`}>
  <div class="row-left">
    <div class="stock-identity">
      <span class="stock-code">{entry.code}</span>
      <span class="stock-market">{entry.market || "—"}</span>
      <span class="stock-name">{entry.name_zh || "—"}</span>
    </div>
  </div>

  <div class="row-center">
    <div class="col col-amount">
      <span class="col-label">投信 10 日買超</span>
      <span class="col-value col-value-primary">{fmtAmount(entry.net_amount_10d)}</span>
      <span class="col-sub">{fmtShares(entry.net_shares_10d_zhang ?? entry.net_shares_10d / 1000)}</span>
    </div>

    <div class="col col-date">
      <span class="col-label">資料日</span>
      <span class="col-value">{entry.screening_date || entry.last_date}</span>
      <span class="col-sub">排行 #{entry.rank ?? "—"}</span>
    </div>

    <div class="category-block" aria-label="七大類分數">
      {categoryMeta.map(([key, label]) => {
        const category = categories[key];
        return (
          <div class:list={["category-pill", statusClass(category)]} title={category ? `${category.passed} passed, ${category.failed} failed, ${category.unknown} unknown` : "資料不足"}>
            <span class="pill-label">{label}</span>
            <span class="pill-value">{category?.score || "—"}</span>
            <span class="pill-percent">{categoryPercent(category)}</span>
          </div>
        );
      })}
    </div>

    <div class="col col-price">
      <span class="col-label">收盤價</span>
      <span class="col-value">{Number(entry.cur_price || 0).toFixed(2)}</span>
      <span class="col-sub">{entry.last_date || "—"}</span>
    </div>

    <div class="col col-z">
      <span class="col-label">Z</span>
      <span class:list={["col-value", { "z-pass": entry.regression_z != null && entry.regression_z <= 0, "z-unknown": entry.regression_z == null }]}>{fmtZ(entry.regression_z)}</span>
    </div>
  </div>
</a>

<style>
.screening-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 18px;
  border-radius: var(--radius-md, 8px);
  color: var(--color-text, #0a0a0a);
  text-decoration: none;
  position: relative;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.screening-row:hover {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 1px var(--color-accent);
}
.screening-row.is-archive { opacity: 0.72; }
.screening-row.is-archive:hover { opacity: 0.94; }
.row-left { flex: 0 0 110px; min-width: 0; }
.row-center { flex: 1 1 auto; display: flex; align-items: center; gap: 12px; min-width: 0; }
.stock-identity { display: flex; flex-direction: column; gap: 2px; }
.stock-code { font-size: 1.02rem; font-weight: 800; letter-spacing: 0.02em; }
.stock-market { font-size: 0.58rem; color: var(--color-accent); font-weight: 700; }
.stock-name { font-size: 0.76rem; color: var(--color-muted, #667085); max-width: 105px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 0 0 auto; }
.col-label { font-size: 0.62rem; font-weight: 750; color: var(--color-muted, #667085); letter-spacing: 0.04em; }
.col-value { font-size: 0.85rem; font-weight: 700; }
.col-value-primary { font-size: 0.92rem; }
.col-sub { font-size: 0.68rem; color: var(--color-text-muted); }
.col-amount { min-width: 116px; }
.col-date { min-width: 86px; }
.col-price { min-width: 78px; }
.col-z { min-width: 45px; }
.z-pass { color: var(--color-accent); }
.z-unknown { color: var(--color-text-muted); font-weight: 500; }
.category-block { display: flex; flex-wrap: wrap; gap: 4px; flex: 1 1 430px; min-width: 270px; }
.category-pill { min-width: 48px; padding: 3px 6px; display: flex; flex-direction: column; align-items: center; border-radius: 6px; background: rgba(128,128,128,0.07); }
.category-pill.pass { background: var(--color-accent-soft); }
.category-pill.fail { background: rgba(242,54,69,0.07); }
.category-pill.unknown { background: rgba(128,128,128,0.04); }
.pill-label { font-size: 0.56rem; font-weight: 750; color: var(--color-muted, #667085); }
.pill-value { font-size: 0.74rem; font-weight: 850; color: var(--color-text); }
.category-pill.pass .pill-label, .category-pill.pass .pill-percent, .category-pill.pass .pill-value { color: var(--color-accent); }
.category-pill.fail .pill-percent { color: var(--color-down, #f23645); }
.pill-percent { font-size: 0.55rem; color: var(--color-text-muted); }
@media (max-width: 1100px) {
  .category-block { flex-basis: 330px; min-width: 220px; }
  .category-pill { min-width: 42px; }
}
@media (max-width: 800px) {
  .screening-row { align-items: flex-start; padding: 11px 14px; }
  .row-center { flex-wrap: wrap; gap: 8px; }
  .category-block { order: 10; flex-basis: 100%; min-width: 100%; }
  .category-pill { flex: 1 1 42px; }
}
@media (max-width: 500px) {
  .row-left { flex: 0 0 78px; }
  .stock-name { max-width: 78px; }
  .col-amount { min-width: 96px; }
  .col-date { min-width: 74px; }
}
</style>
