---
// ScreeningRow.astro — Table-style card for screening results
// Preserves glass-morphism design tokens from Layout.astro.

export interface ScreeningEntry {
  code: string;
  name_zh: string;
  name_en: string;
  net_amount_10d: number;
  net_amount_10d_k: number;
  net_shares_10d: number;
  net_shares_10d_zhang: number;
  first_date: string;
  last_date: string;
  consecutive_buy_days: number;
  cur_price: number;
  g_score: number;
  l_score: number;
  regression_z: number;
  rank: number;
  screening_date: string;
}

interface Props {
  entry: ScreeningEntry;
  variant?: "active" | "archive";
}

const { entry, variant = "active" } = Astro.props;
const isArchive = variant === "archive";

function fmtAmount(v: number): string {
  if (v >= 1e8) return (v / 1e8).toFixed(2) + " 億";
  if (v >= 1e4) return (v / 1e4).toFixed(1) + " 萬";
  return v.toLocaleString();
}

function fmtShares(zhang: number): string {
  if (zhang >= 10000) return (zhang / 10000).toFixed(1) + " 萬張";
  if (zhang >= 1000) return (zhang / 1000).toFixed(1) + " 千張";
  return zhang + " 張";
}

const statementUrl = `https://statementdog.com/analysis/${entry.code}`;
---

<a href={statementUrl} target="_blank" rel="noopener" class:list={["screening-row", "glass-surface", { "is-archive": isArchive }]}>
  <div class="row-left">
    <div class="stock-identity">
      <span class="stock-code">{entry.code}</span>
      <span class="stock-name">{entry.name_zh || "—"}</span>
    </div>
  </div>

  <div class="row-center">
    <div class="col col-amount">
      <span class="col-label">投信10日買超</span>
      <span class="col-value col-value-primary">{fmtAmount(entry.net_amount_10d)}</span>
      <span class="col-sub">{fmtShares(entry.net_shares_10d_zhang)}</span>
    </div>

    <div class="col col-consecutive">
      <span class="col-label">連續買超</span>
      <span class="col-value">{entry.consecutive_buy_days} 日</span>
    </div>

    <div class="col col-dates">
      <span class="col-label">首次上榜</span>
      <span class="col-value">{entry.first_date}</span>
      <span class="col-sub">最新: {entry.last_date}</span>
    </div>

    {isArchive && (
      <div class="col col-date">
        <span class="col-label">篩選日期</span>
        <span class="col-value">{entry.screening_date}</span>
      </div>
    )}

    <div class="col col-score">
      <span class="col-label">成長</span>
      <span class:list={["score-num", { pass: entry.g_score >= 80 }]}>
        {entry.g_score.toFixed(0)}
      </span>
    </div>

    <div class="col col-score">
      <span class="col-label">地雷</span>
      <span class:list={["score-num", { pass: entry.l_score >= 80 }]}>
        {entry.l_score.toFixed(0)}
      </span>
    </div>

    <div class="col col-score col-placeholder">
      <span class="col-label">便宜</span>
      <span class="col-value col-muted">—</span>
    </div>

    <div class="col col-score col-placeholder">
      <span class="col-label">定存</span>
      <span class="col-value col-muted">—</span>
    </div>

    <div class="col col-price">
      <span class="col-label">股價</span>
      <span class="col-value col-value-price">{entry.cur_price.toFixed(1)}</span>
    </div>

    <div class="col col-z">
      <span class="col-label">Z</span>
      <span class="col-value col-muted">{entry.regression_z.toFixed(2)}</span>
    </div>
  </div>
</a>

<style>
.screening-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 18px;
  border-radius: var(--radius-card, 8px);
  color: var(--color-text, #17202a);
  text-decoration: none;
  position: relative;
  overflow: hidden;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}
.screening-row::after {
  position: absolute;
  inset: 1px 1px auto 1px;
  height: 52%;
  content: "";
  border-radius: inherit;
  background: linear-gradient(180deg, rgba(255,255,255,0.34), transparent);
  pointer-events: none;
}
.screening-row:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover, 0 24px 70px rgba(36,55,72,0.2));
  border-color: rgba(23, 107, 135, 0.34);
}
.screening-row.is-archive {
  opacity: 0.72;
}
.screening-row.is-archive:hover {
  opacity: 0.92;
}

.row-left {
  flex: 0 0 110px;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.row-center {
  flex: 1 1 auto;
  display: flex;
  gap: 12px;
  min-width: 0;
  position: relative;
  z-index: 1;
  align-items: center;
}

.stock-identity {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.stock-code {
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.02em;
}
.stock-name {
  font-size: 0.78rem;
  color: var(--color-muted, #667085);
  max-width: 100px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}
.col-label {
  font-size: 0.65rem;
  font-weight: 750;
  color: var(--color-muted, #667085);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.col-value {
  font-size: 0.88rem;
  font-weight: 700;
}
.col-value-primary {
  font-size: 0.95rem;
  font-weight: 800;
  color: var(--color-text);
}
.col-value-price {
  font-size: 1.05rem;
  font-weight: 850;
}
.col-sub {
  font-size: 0.7rem;
  color: var(--color-muted, #667085);
}
.col-muted {
  color: var(--color-muted, #667085);
  font-weight: 500;
}

.col-amount { min-width: 120px; }
.col-consecutive { min-width: 64px; }
.col-dates { min-width: 100px; }
.col-date { min-width: 90px; }
.col-score { min-width: 52px; align-items: flex-start; }
.col-price { min-width: 60px; }
.col-z { min-width: 48px; }
.col-placeholder { opacity: 0.5; }

.score-num {
  font-size: 0.92rem;
  font-weight: 850;
  padding: 2px 6px;
  border-radius: 5px;
}
.score-num.pass {
  color: #138f6a;
  background: rgba(19, 143, 106, 0.1);
}

@media (max-width: 900px) {
  .screening-row { flex-wrap: wrap; gap: 10px; padding: 12px 14px; }
  .row-left { flex: 0 0 100%; flex-direction: row; }
  .stock-identity { flex-direction: row; gap: 8px; align-items: baseline; }
  .row-center { flex-wrap: wrap; gap: 10px; }
}
@media (max-width: 520px) {
  .col { min-width: auto; }
  .col-score { align-items: center; }
  .row-center { gap: 8px; }
}
</style>
