---
// ScreeningRow.astro — Table-style card for screening results
// Preserves glass-morphism design tokens from Layout.astro.
import { CRITERIA_GROUPS, criteriaMeta, groupResult, type CriteriaGroups } from "../lib/criteria";

export interface ScreeningEntry {
  code: string;
  name_zh: string;
  name_en: string;
  net_amount_10d: number;
  net_amount_10d_k: number;
  net_shares_10d: number;
  net_shares_10d_zhang: number;
  first_date: string;
  last_date: string;
  cur_price: number;
  first_price?: number | null;
  change_pct?: number | null;
  g_score: number;
  l_score: number;
  cheap_score?: number | null;
  dividend_score?: number | null;
  regression_z: number;
  rank: number;
  screening_date: string;
  ex_dividend_date?: string | null;
  dividend_per_share?: number | null;
  valuation?: {
    peg?: number | null;
    peg_y?: number | null;
    pe?: number | null;
    div_yield_3y_pct?: number | null;
    avg_fill_days?: number | null;
    fill_rate?: number | null;
  } | null;
  criteria_groups?: CriteriaGroups | null;
}

interface Props {
  entry: ScreeningEntry;
  variant?: "active" | "archive";
}

const { entry, variant = "active" } = Astro.props;
const isArchive = variant === "archive";
const criteriaSummary = criteriaMeta(entry.criteria_groups);
const criteriaSummaryLabel = criteriaSummary.complete ? `通過 ${criteriaSummary.passed}/7` : "7 類待完整資料";

function fmtAmount(v: number): string {
  if (v >= 1e8) return (v / 1e8).toFixed(2) + " 億";
  if (v >= 1e4) return (v / 1e4).toFixed(1) + " 萬";
  return v.toLocaleString();
}

function fmtShares(zhang: number): string {
  if (zhang >= 10000) return (zhang / 10000).toFixed(1) + " 萬張";
  if (zhang >= 1000) return (zhang / 1000).toFixed(1) + " 千張";
  return zhang + " 張";
}

function hasValue(v: number | null | undefined): boolean {
  return v != null && !isNaN(v);
}

const statementUrl = `https://statementdog.com/analysis/${entry.code}`;

function isFutureDiv(dateStr: string): boolean {
  if (!dateStr) return false;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return new Date(dateStr) > today;
}

function formatDivDate(dateStr: string): string {
  if (!dateStr) return "—";
  const d = new Date(dateStr);
  return `${d.getMonth() + 1}/${d.getDate()}`;
}
---

<a href={statementUrl} target="_blank" rel="noopener" class:list={["screening-row", "surface", { "is-archive": isArchive }]}>
  <div class="row-left">
    <div class="stock-identity">
      <span class="stock-code">{entry.code}</span>
      <span class="stock-name">{entry.name_zh || "—"}</span>
    </div>
  </div>

  <div class="row-center">
    <div class="col col-amount">
      <span class="col-label">投信10日買超</span>
      <span class="col-value col-value-primary">{fmtAmount(entry.net_amount_10d)}</span>
      <span class="col-sub">{fmtShares(entry.net_shares_10d_zhang)}</span>
    </div>

    <div class="col col-dates">
      <span class="col-label">首次上榜</span>
      <span class="col-value">{entry.first_date}</span>
      <span class="col-sub">最新: {entry.screening_date}</span>
    </div>

    {isArchive && (
      <div class="col col-date">
        <span class="col-label">篩選日期</span>
        <span class="col-value">{entry.screening_date}</span>
      </div>
    )}

    <!-- Seven exact criteria groups. Missing snapshots stay UNKNOWN. -->
    <div class="criteria-block" aria-label="Seven criteria status">
      <span class="criteria-overall">{criteriaSummaryLabel}</span>
      {CRITERIA_GROUPS.map((group) => {
        const view = groupResult(group, entry.criteria_groups);
        return (
          <span class:list={["criteria-pill", `state-${view.state}`]} title={`${group.label}: ${view.detail === "—" ? "UNKNOWN" : view.detail}`}>
            <span class="criteria-label">{group.label}</span>
            <strong>{view.symbol}</strong>
          </span>
        );
      })}
    </div>

    <!-- Legacy scores remain visible but are not treated as the 33-criterion result. -->
    <div class="legacy-score-block" aria-label="Legacy display scores">
      <span>舊分數</span>
      <span>G {entry.g_score.toFixed(0)}</span>
      <span>L {entry.l_score.toFixed(0)}</span>
      <span>便宜 {hasValue(entry.cheap_score) ? entry.cheap_score!.toFixed(0) : "—"}</span>
      <span>定存 {hasValue(entry.dividend_score) ? entry.dividend_score!.toFixed(0) : "—"}</span>
    </div>

    <div class="col col-price-block">
      <span class="col-label">股價追蹤</span>
      <div class="price-track">
        <span class="price-first">{hasValue(entry.first_price) ? entry.first_price!.toFixed(1) : '—'}</span>
        <span class="price-arrow">→</span>
        <span class="price-now">{entry.cur_price.toFixed(1)}</span>
      </div>
      {hasValue(entry.change_pct) && (
        <span class:list={["price-change", { 'change-up': entry.change_pct! > 0, 'change-down': entry.change_pct! < 0 }]}>
          {entry.change_pct! > 0 ? '+' : ''}{entry.change_pct!.toFixed(1)}%
        </span>
      )}
      {!hasValue(entry.change_pct) && <span class="price-change price-na">—</span>}
    </div>

    <div class="col col-z">
      <span class="col-label">Z</span>
      <span class="col-value col-muted">{entry.regression_z.toFixed(2)}</span>
    </div>

    {hasValue(entry.dividend_per_share) && (
      <div class="col col-div">
        <span class="col-label">配息</span>
        <span class="col-value">{entry.dividend_per_share!.toFixed(1)} 元</span>
        {entry.ex_dividend_date && (
          <span class:list={["col-sub", { "div-future": isFutureDiv(entry.ex_dividend_date) }]}>
            除息 {formatDivDate(entry.ex_dividend_date)}
          </span>
        )}
      </div>
    )}

    {hasValue(entry.valuation) && (
      <div class="col col-valuation">
        <span class="col-label">PEGY</span>
        <span class:list={["col-value", { "peg-cheap": (entry.valuation!.peg_y ?? Infinity) < 0.75 }]}>
          {hasValue(entry.valuation!.peg_y) ? entry.valuation!.peg_y!.toFixed(2) : "—"}
        </span>
        {hasValue(entry.valuation!.pe) && (
          <span class="col-sub">PE {entry.valuation!.pe!.toFixed(1)}</span>
        )}
      </div>
    )}
  </div>
</a>

<style>
.screening-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 18px;
  border-radius: var(--radius-md, 8px);
  color: var(--color-text, #0a0a0a);
  position: relative;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.screening-row:hover {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 1px var(--color-accent);
}
.screening-row.is-archive {
  opacity: 0.72;
}
.screening-row.is-archive:hover {
  opacity: 0.92;
}

.row-left {
  flex: 0 0 105px;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.row-center {
  flex: 1 1 auto;
  display: flex;
  gap: 10px;
  min-width: 0;
  position: relative;
  z-index: 1;
  align-items: center;
}

.stock-identity {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.stock-code {
  font-size: 1.02rem;
  font-weight: 800;
  letter-spacing: 0.02em;
}
.stock-name {
  font-size: 0.76rem;
  color: var(--color-muted, #667085);
  max-width: 95px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  flex: 0 0 auto;
}
.col-label {
  font-size: 0.62rem;
  font-weight: 750;
  color: var(--color-muted, #667085);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.col-value {
  font-size: 0.85rem;
  font-weight: 700;
}
.col-value-primary {
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--color-text);
}
.col-sub {
  font-size: 0.68rem;
  color: var(--color-text-muted);
}
.col-muted {
  color: var(--color-text-muted);
  font-weight: 500;
}

.col-valuation { min-width: 72px; }
.col-valuation .peg-cheap {
  color: #089981; /* PEGY < 0.75：祖魯法則便宜區（TradingView 漲色） */
}

.col-amount { min-width: 115px; }
.col-dates { min-width: 95px; }
.col-date { min-width: 85px; }
.col-price-block { min-width: 118px; }
.col-z { min-width: 44px; }

.col-div { min-width: 72px; }
.col-div .col-value {
  font-size: 0.82rem;
  font-weight: 750;
}
.col-div .div-future {
  color: var(--color-accent, #c96442);
  font-weight: 700;
}

/* ── Price tracking block ── */
.price-track {
  display: flex;
  align-items: baseline;
  gap: 5px;
}
.price-first {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--color-muted, #667085);
}
.price-arrow {
  font-size: 0.65rem;
  color: var(--color-muted, #667085);
  font-weight: 400;
}
.price-now {
  font-size: 1.02rem;
  font-weight: 850;
  color: var(--color-text);
}
.price-change {
  font-size: 0.84rem;
  font-weight: 800;
  margin-top: 2px;
}
.price-change.change-up {
  color: #089981;
}
.price-change.change-down {
  color: #F23645;
}
.price-change.price-na {
  font-size: 0.7rem;
  color: var(--color-muted, #667085);
  font-weight: 400;
}

/* ── Seven-criteria status block ── */
.criteria-block {
  display: inline-flex;
  flex: 0 0 auto;
  flex-wrap: wrap;
  gap: 4px;
  max-width: 300px;
}
.criteria-overall {
  display: inline-flex;
  align-items: center;
  padding: 4px 7px;
  border-radius: 999px;
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-size: 0.64rem;
  font-weight: 800;
  white-space: nowrap;
}
.criteria-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-width: 42px;
  justify-content: center;
  padding: 4px 6px;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: var(--color-bg-subtle);
  color: var(--color-text-muted);
  font-size: 0.64rem;
  font-weight: 750;
}
.criteria-pill strong {
  font-size: 0.78rem;
  line-height: 1;
}
.criteria-pill.state-pass {
  border-color: rgba(19, 143, 106, 0.28);
  background: rgba(19, 143, 106, 0.08);
  color: var(--color-down);
}
.criteria-pill.state-fail {
  border-color: rgba(181, 51, 51, 0.25);
  background: rgba(181, 51, 51, 0.07);
  color: var(--color-up);
}
.criteria-pill.state-unknown {
  border-style: dashed;
  color: var(--color-text-muted);
}
.criteria-label {
  letter-spacing: 0.01em;
}
.legacy-score-block {
  display: inline-flex;
  flex: 0 1 auto;
  flex-wrap: wrap;
  gap: 3px 7px;
  max-width: 190px;
  color: var(--color-text-muted);
  font-size: 0.62rem;
  line-height: 1.3;
}
.legacy-score-block span:first-child {
  width: 100%;
  font-weight: 750;
  color: var(--color-text-soft);
}

/* ── Legacy score block retained for backwards-compatible styling ── */
.score-block {
  display: inline-flex;
  gap: 5px;
  align-items: center;
  flex: 0 0 auto;
  padding: 2px 4px;
  border-radius: 8px;
  background: rgba(128, 128, 128, 0.04);
}
.score-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  padding: 3px 8px;
  border-radius: 6px;
  min-width: 48px;
  background: rgba(128, 128, 128, 0.06);
}
.pill-label {
  font-size: 0.58rem;
  font-weight: 750;
  color: var(--color-muted, #667085);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.pill-value {
  font-size: 0.88rem;
  font-weight: 850;
  color: var(--color-text);
}
.score-pill.pass {
  background: var(--color-accent-soft);
}
.score-pill.pass .pill-value {
  color: var(--color-accent);
}
.score-pill.pass .pill-label {
  color: var(--color-accent);
}

@media (max-width: 960px) {
  .row-center { flex-wrap: wrap; gap: 8px; }
  .criteria-block,
  .legacy-score-block { order: 10; }
  .criteria-block { max-width: none; }
}
@media (max-width: 700px) {
  .screening-row { flex-wrap: wrap; gap: 8px; padding: 10px 14px; }
  .row-left { flex: 0 0 100%; }
  .stock-identity { flex-direction: row; gap: 8px; align-items: baseline; }
  .criteria-block {
    width: 100%;
    justify-content: space-between;
  }
  .criteria-pill { flex: 1 1 0; min-width: 0; }
  .legacy-score-block { max-width: none; }
}
@media (max-width: 420px) {
  .criteria-pill { padding: 3px 4px; }
  .criteria-label { font-size: 0.56rem; }
  .criteria-pill strong { font-size: 0.72rem; }
  .score-pill { min-width: 40px; padding: 3px 5px; }
  .pill-value { font-size: 0.8rem; }
}
</style>
