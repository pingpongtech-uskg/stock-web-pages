---
// Layout.astro — Common page wrapper
interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf4f6" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="mask-icon" href={`${base}logo.svg`} color="#111827" />
    <style is:global>
      :root {
        --color-bg: #edf4f6;
        --color-bg-2: #fbfaf6;
        --color-card: rgba(255, 255, 255, 0.66);
        --color-card-strong: rgba(255, 255, 255, 0.82);
        --color-text: #17202a;
        --color-muted: #667085;
        --color-line: rgba(99, 112, 132, 0.2);
        --color-up: #d94b42;
        --color-down: #138f6a;
        --color-primary: #176b87;
        --color-accent: #f0a35b;
        --color-ink-soft: rgba(23, 32, 42, 0.68);
        --radius-card: 8px;
        --radius-btn: 8px;
        --shadow-card: 0 18px 55px rgba(36, 55, 72, 0.13), inset 0 1px 0 rgba(255,255,255,0.85);
        --shadow-hover: 0 24px 70px rgba(36, 55, 72, 0.2), inset 0 1px 0 rgba(255,255,255,0.9);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-bg: #111820;
          --color-bg-2: #1b241f;
          --color-card: rgba(28, 38, 48, 0.68);
          --color-card-strong: rgba(34, 45, 55, 0.86);
          --color-text: #f4f7f8;
          --color-muted: #a6b2bf;
          --color-line: rgba(220, 230, 236, 0.18);
          --color-primary: #7cc7d8;
          --color-accent: #f0b46f;
          --color-ink-soft: rgba(244, 247, 248, 0.72);
          --shadow-card: 0 20px 60px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.12);
          --shadow-hover: 0 24px 72px rgba(0,0,0,0.42), inset 0 1px 0 rgba(255,255,255,0.16);
        }
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--color-bg);
      }

      body {
        min-height: 100vh;
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", sans-serif;
        background:
          linear-gradient(125deg, var(--color-bg) 0%, var(--color-bg-2) 58%, #e8f1ee 100%);
        color: var(--color-text);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      body::before {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: "";
        background-image:
          linear-gradient(rgba(255,255,255,0.28) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.24) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent 72%);
      }

      a {
        color: inherit;
      }

      button,
      input {
        font: inherit;
      }

      .container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
      }

      .glass-surface {
        background: var(--color-card);
        border: 1px solid var(--color-line);
        box-shadow: var(--shadow-card);
        backdrop-filter: blur(22px) saturate(145%);
        -webkit-backdrop-filter: blur(22px) saturate(145%);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
