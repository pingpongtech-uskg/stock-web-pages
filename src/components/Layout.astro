---
// Layout.astro — Flat minimal wrapper (Vercel/Linear inspired)
// No glass morphism. No gradients. Pure, clean, data-first.
interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="mask-icon" href={`${base}logo.svg`} color="#0a0a0a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        /* Surfaces */
        --color-bg: #ffffff;
        --color-bg-subtle: #f8f9fa;
        --color-surface: #ffffff;
        --color-surface-hover: #f4f5f6;
        --color-border: #e5e7eb;
        --color-border-strong: #d1d5db;

        /* Text */
        --color-text: #0a0a0a;
        --color-text-soft: #4b5563;
        --color-text-muted: #9ca3af;
        --color-text-inverse: #ffffff;

        /* Accent */
        --color-accent: #3B82F6;
        --color-accent-soft: #eff6ff;
        --color-accent-hover: #2563eb;

        /* Semantic */
        --color-up: #dc2626;
        --color-down: #16a34a;

        /* Metrics */
        --radius-sm: 6px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
        --shadow-md: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-bg: #0a0a0a;
          --color-bg-subtle: #141414;
          --color-surface: #171717;
          --color-surface-hover: #1f1f1f;
          --color-border: #2a2a2a;
          --color-border-strong: #3a3a3a;

          --color-text: #fafafa;
          --color-text-soft: #a3a3a3;
          --color-text-muted: #737373;
          --color-text-inverse: #0a0a0a;

          --color-accent: #60A5FA;
          --color-accent-soft: #0f1f33;
          --color-accent-hover: #93C5FD;

          --color-up: #f87171;
          --color-down: #4ade80;

          --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
          --shadow-md: 0 1px 3px rgba(0,0,0,0.4);
        }
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--color-bg);
      }

      body {
        min-height: 100vh;
        margin: 0;
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        font-size: 15px;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
      }

      .container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
      }

      /* Flat surface card */
      .surface {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
      }

      .surface:hover {
        border-color: var(--color-border-strong);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
