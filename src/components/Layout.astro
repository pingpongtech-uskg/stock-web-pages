---
// Layout.astro — Flat minimal wrapper (Vercel/Linear inspired)
// No glass morphism. No gradients. Pure, clean, data-first.
interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="mask-icon" href={`${base}logo.svg`} color="#0a0a0a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        /* Surfaces — Claude warm parchment palette */
        --color-bg: #f5f4ed;
        --color-bg-subtle: #faf9f5;
        --color-surface: #faf9f5;
        --color-surface-hover: #f0eee6;
        --color-border: #f0eee6;
        --color-border-strong: #e8e6dc;

        /* Text — warm-toned */
        --color-text: #141413;
        --color-text-soft: #5e5d59;
        --color-text-muted: #87867f;
        --color-muted: #87867f;
        --color-line: #f0eee6;
        --color-text-inverse: #faf9f5;

        /* Accent — Terracotta */
        --color-accent: #c96442;
        --color-accent-soft: rgba(201, 100, 66, 0.08);
        --color-accent-hover: #d97757;

        /* Semantic */
        --color-up: #b53333;
        --color-down: #138f6a;

        /* Metrics */
        --radius-sm: 6px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --shadow-sm: 0 1px 2px rgba(20, 20, 19, 0.04);
        --shadow-md: 0 1px 3px rgba(20, 20, 19, 0.06), 0 1px 2px rgba(20, 20, 19, 0.04);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-bg: #141413;
          --color-bg-subtle: #1c1c1a;
          --color-surface: #30302e;
          --color-surface-hover: #3d3d3a;
          --color-border: #30302e;
          --color-border-strong: #4d4c48;

          --color-text: #faf9f5;
          --color-text-soft: #b0aea5;
          --color-text-muted: #87867f;
          --color-muted: #87867f;
          --color-line: #30302e;
          --color-text-inverse: #141413;

          --color-accent: #d97757;
          --color-accent-soft: rgba(217, 119, 87, 0.1);
          --color-accent-hover: #e08d6f;

          --color-up: #e05555;
          --color-down: #4ade80;

          --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
          --shadow-md: 0 1px 3px rgba(0,0,0,0.4);
        }
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--color-bg);
      }

      body {
        min-height: 100vh;
        margin: 0;
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        font-size: 15px;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
      }

      .container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
      }

      /* Flat surface card */
      .surface {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
      }

      .surface:hover {
        border-color: var(--color-border-strong);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
