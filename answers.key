    "signal_not_hindsight": {
      "scenario": "歷史t的訊號已保存；加入t+1至t+250的價格並改變最新回歸線。",
      "expected": "原t訊號及其input_hash不變；當期診斷圖可改變，但不能重畫成歷史買點。"
    }
  },
  "criteria": [
    {
      "id": "DATA-01",
      "stage": "P0",
      "status": "not_run",
      "title": "四來源範圍",
      "given": "全新repo與來源registry。",
      "when": "執行完整金融資料取得及網路記錄。",
      "expected": "金融來源僅FinMind、yfinance、TWSE、TPEx；無財報狗、TDCC、新聞、公司官網或AI API依赖。儲存與部署流量另列。",
      "evidence": [
        "config/source_registry.json",
        "來源allowlist測試",
        "受控網路請求記錄"
      ]
    },
    {
      "id": "DATA-02",
      "stage": "P0",
      "status": "not_run",
      "title": "公司母體",
      "given": "包含普通股、ETF、權證、興櫃、金融股、KY、前導零與轉板的fixture。",
      "when": "建立母體及策略適用名單。",
      "expected": "TWSE/TPEx普通股為母體；其他商品排除；金融股可搜尋但非金融規則not_applicable；轉板以有效期識別，代碼維持字串。",
      "evidence": [
        "tests/unit/test_universe.py",
        "母體分類報告"
      ]
    },
    {
      "id": "DATA-03",
      "stage": "P0",
      "status": "not_run",
      "title": "來源與單位可追溯",
      "given": "任一行情、法人或財務指標。",
      "when": "展開指標來源。",
      "expected": "可找到來源URL、資料日、取得時間、單位、原始欄位、hash、版本；股/張、元/千元及幣別转换正確。",
      "evidence": [
        "正規化fixtures",
        "manifest",
        "個股來源展開截圖"
