        "slope": 1.4,
        "last_mid": 14.1,
        "residual_sum_squares": 4.2,
        "variance_ddof0": 1.05
      },
      "expected_sigma_expression": "sqrt(1.05)",
      "expected_last_z_expression": "0.9/sqrt(1.05)",
      "expected_bands_expression": "14.1 + k*sqrt(1.05), k=-2,-1,0,1,2",
      "absolute_tolerance": 1e-08
