{
  "schema_version": "1.0",
  "document_type": "acceptance_criteria",
  "project": "台股低位研究室",
  "plan": "PLAN.md",
  "created_at": "2026-09-08",
  "status": "specification_only",
  "contains_credentials": false,
  "instructions": "本檔是驗收標準，不是API金鑰或已通過的測試報告。每個項目目前皆未執行；只有實際證據才能改成pass。投資報酬目標與軟體完成分開判斷。",
  "result_values": [
    "not_run",
    "pass",
    "fail",
    "blocked"
  ],
  "evidence_report_contract": {
    "required_fields": [
      "criterion_id",
      "result",
      "tested_at",
      "git_commit",
      "evidence_paths",
      "notes"
    ],
    "rule": "一項一列；evidence_paths必須存在。blocked不能視為pass，歷史研究資料不完整只能通過誠實呈現限制的軟體項，不能通過嚴格績效認證。"
  },
  "release_gates": {
    "daily_site": [
      "DATA",
      "OPS",
      "RANK",
      "LOHAS",
      "RULE",
      "UI",
      "DISC",
      "DEPLOY",
      "PERF"
    ],
    "complete_v1": [
      "DATA",
      "OPS",
      "RANK",
      "LOHAS",
      "RULE",
      "UI",
      "DISC",
      "DEPLOY",
      "PERF",
      "RESEARCH"
    ],
    "daily_site_research_page": "研究尚未完成時須呈現驗證中與資料缺口，不得以示範績效代替。",
    "investment_target": {
      "cagr_at_least": 0.5,
      "max_drawdown_at_most": 0.3,
      "status": "not_evaluable",
      "software_release_blocker": false,
      "rule": "只有鎖定規則、資料時間可靠、成本完整、樣本外結果才能評估。未達標必須明示，不得改寫門檻或挑選期間。"
    }
  },
  "golden_fixtures": {
    "ols_unit_only": {
      "scope": "只驗證OLS與標準差數學；四年歷史覆蓋門檻另測，不能把這四筆當成合格四年資料。",
      "x": [
        0,
        1,
